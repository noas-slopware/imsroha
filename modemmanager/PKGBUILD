# Maintainer: Noa Himesaka <himesaka@noa.codes>
# SPDX-License-Identifier: GPL-3.0-only
# (this recipe; ModemManager and the patches to it are GPL-2.0-or-later)
#
# ModemManager 1.24.2 with the IMSroha backend (voice and messaging handed to
# imsroha over D-Bus), the bearer-count crash fix, IMS DTMF, the kept IPA QMAP
# path, per-carrier SMS (SKT keeps SMS on the modem) and port-addressed SMS
# from the modem handed to imsroha, all from this directory (see README.md;
# 0002 is kept for reference and not applied).
#
#   makepkg -s
#
# Install the result with `pacman -U`. pkgrel is above the Arch package's, so
# this build wins. The udev rule that enables the backend ships with imsroha.

pkgname=modemmanager
pkgver=1.24.2
pkgrel=16
pkgdesc="Mobile broadband modem management service with IMSroha (userspace IMS) support"
url="https://www.freedesktop.org/wiki/Software/ModemManager/"
arch=(aarch64 x86_64)
license=(GPL-2.0-or-later)
depends=(
  bash
  glib2
  glibc
  hicolor-icon-theme
  libgcc
  libgudev
  libmbim
  libqmi
  libqrtr-glib
  mobile-broadband-provider-info
  polkit
  ppp
  systemd-libs
  libmm-glib
)
makedepends=(
  bash-completion
  git
  glib2-devel
  gobject-introspection
  # include/meson.build runs xsltproc even with gtk_doc off (Arch gets it through gtk-doc)
  libxslt
  meson
  systemd
)
source=(
  "git+https://gitlab.freedesktop.org/mobile-broadband/ModemManager.git#tag=${pkgver}"
  "0001-broadband-modem-qmi-add-imsroha-backend-for-voice-and-messaging.patch"
  "0003-iface-modem-do-not-abort-when-the-bearer-count-exceeds.patch"
  "0004-call-ims-send-DTMF-through-imsroha.patch"
  "0005-port-qmi-keep-the-IPA-QMAP-data-path-when-another-PDN.patch"
  "0006-broadband-modem-qmi-leave-SMS-with-the-modem-where-the-carrier-has-no-SMS-over-IP.patch"
  "0007-netlink-fix-use-after-free-calling-completion_fn-on-transaction-completion.patch"
  "0008-broadband-modem-qmi-hand-port-addressed-SMS-to-imsroha.patch"
)
b2sums=(
  'SKIP'
  'd904e1cf6ba3268d9a5330c0157282674cc0d6f2e35e3233e954f09235bdd27911144ffb3169649f18038927d49d39d7f44d6ec3733237298d7375adfff8135a'
  '24bb2494310c45f5ef27a447e8530375741daf32f20f3c396d281143b44e93a6b1d85b3f65e28520f5ac0a115142d33a94877612db9a2dd7e8d3a2075bfef3bf'
  '7bb38fde31fc5b8bb069e6c28afca042c071b12d865abca48111b838d0f3a8abae6b5940e1b287e8f7a30980d4fffce47a6f0f9322ea7b8b298cccf8b81a6645'
  'e215477136dac72d1ee429ee7297815ba35ed42d7c9c2ad125a0c4aee5f32e8a1965b69ffb0c70afab0cfaa4a85021c910cb7f4912fdeae1f8226b4068d8db67'
  '5a149bff976d549eb6e4195ab6fa97e05fd0166c8cec1fe52d3fa5e8b269b978e696a5e4b33fd587ffadca69b7ab1a06d9e4b33a056f605bda9939bb3e957c42'
  '6bc514c7b6c7a295a285f82019e5faae5f89d0c700c8da593e3cad505db6658b7a34b8a2436b198861f40d3eed7c95c73920ebb027e0a5d2f2af2e0f3cf8483f'
  '50f11564a4850492e4ea488f6826bafe2688f9b759b335a3f50ccf1c547dcb05ae6c25c3c3396a6281a3f5145db5097c3b4c58624ac0400e9b1985b035692e4c'
)

prepare() {
  cd ModemManager
  git apply "$srcdir/0001-broadband-modem-qmi-add-imsroha-backend-for-voice-and-messaging.patch"
  git apply "$srcdir/0003-iface-modem-do-not-abort-when-the-bearer-count-exceeds.patch"
  git apply "$srcdir/0004-call-ims-send-DTMF-through-imsroha.patch"
  git apply "$srcdir/0005-port-qmi-keep-the-IPA-QMAP-data-path-when-another-PDN.patch"
  git apply "$srcdir/0006-broadband-modem-qmi-leave-SMS-with-the-modem-where-the-carrier-has-no-SMS-over-IP.patch"
  # upstream 9317cbc4 (after 1.24.2): ModemManager crashed on reconnect (2026-11-11)
  git apply "$srcdir/0007-netlink-fix-use-after-free-calling-completion_fn-on-transaction-completion.patch"
  # RCS OTP where SMS stays with the modem (SKT): port SMS go to imsroha
  git apply "$srcdir/0008-broadband-modem-qmi-hand-port-addressed-SMS-to-imsroha.patch"
}

build() {
  local meson_options=(
    -D dbus_policy_dir=/usr/share/dbus-1/system.d
    -D dist_version="\"$pkgver-$pkgrel\""
    -D gtk_doc=false
    -D vapi=false
    -D polkit=permissive
  )

  arch-meson ModemManager build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  # Keep libmm-glib files out so there are no conflicts with libmm-glib package
  rm -rf "$pkgdir"/usr/include
  rm -rf "$pkgdir"/usr/lib/pkgconfig
  rm -rf "$pkgdir"/usr/lib/libmm-glib.so*
  rm -rf "$pkgdir"/usr/lib/girepository-1.0
  rm -rf "$pkgdir"/usr/share/gir-1.0

}
