diff --git a/src/mm-broadband-modem-qmi.c b/src/mm-broadband-modem-qmi.c
index a8fc8d3..93e4fe4 100644
--- a/src/mm-broadband-modem-qmi.c
+++ b/src/mm-broadband-modem-qmi.c
@@ -8035,6 +8035,140 @@ load_initial_sms_parts_finish (MMIfaceModemMessaging *_self,
 
 static void read_next_sms_part (GTask *task);
 
+/*
+ * Port-addressed SMS (TS 23.040 9.2.3.24.4/5) are for applications, not for
+ * the user's inbox: RCS's OTP and configuration requests, visual voicemail.
+ * With the imsroha backend they go to imsroha, which emits them on
+ * PortPduReceived as it does for SMS over IMS, and they never become an SMS
+ * object. WAP push (2948, 2949: MMS notifications) stays a message. Once
+ * imsroha has the part, it is deleted from modem storage, as nothing else
+ * would ever remove it. If imsroha cannot take it, the part goes to the SMS
+ * list as without the backend, so nothing is lost.
+ */
+typedef struct {
+    MMBroadbandModemQmi  *self;
+    MMSmsPart            *part;
+    QmiWmsStorageType     storage;
+    guint32               index;
+    QmiWmsMessageTagType  tag;
+    guint16               port;
+} ImsrohaPortPartContext;
+
+static void
+imsroha_port_part_delete_ready (QmiClientWms        *client,
+                                GAsyncResult        *res,
+                                MMBroadbandModemQmi *self)
+{
+    g_autoptr(QmiMessageWmsDeleteOutput) output = NULL;
+    g_autoptr(GError)                    error = NULL;
+
+    output = qmi_client_wms_delete_finish (client, res, &error);
+    if (output)
+        qmi_message_wms_delete_output_get_result (output, &error);
+    if (error)
+        mm_obj_warn (self, "couldn't delete the SMS part imsroha took from modem storage: %s",
+                     error->message);
+    g_object_unref (self);
+}
+
+static void
+imsroha_take_port_pdu_ready (MMImsBackendImsroha    *backend,
+                             GAsyncResult           *res,
+                             ImsrohaPortPartContext *ctx)
+{
+    g_autoptr(GError) error = NULL;
+
+    if (!mm_ims_backend_imsroha_take_port_pdu_finish (backend, res, &error)) {
+        mm_obj_warn (ctx->self, "imsroha did not take the SMS part for application port %u: %s; "
+                     "keeping it as a message", ctx->port, error->message);
+        mm_iface_modem_messaging_take_part (MM_IFACE_MODEM_MESSAGING (ctx->self),
+                                            ctx->part,
+                                            mm_sms_state_from_qmi_message_tag (ctx->tag),
+                                            mm_sms_storage_from_qmi_storage_type (ctx->storage));
+    } else {
+        mm_obj_info (ctx->self, "SMS part for application port %u handed to imsroha", ctx->port);
+        mm_sms_part_free (ctx->part);
+
+        if (ctx->storage != QMI_WMS_STORAGE_TYPE_NONE && ctx->index != SMS_PART_INVALID_INDEX) {
+            g_autoptr(QmiMessageWmsDeleteInput) input = NULL;
+            QmiClient                          *client;
+            g_autoptr(GError)                   client_error = NULL;
+
+            client = mm_shared_qmi_peek_client (MM_SHARED_QMI (ctx->self),
+                                                QMI_SERVICE_WMS,
+                                                MM_PORT_QMI_FLAG_DEFAULT,
+                                                &client_error);
+            if (!client) {
+                mm_obj_warn (ctx->self, "couldn't delete the SMS part imsroha took from modem storage: %s",
+                             client_error->message);
+            } else {
+                input = qmi_message_wms_delete_input_new ();
+                qmi_message_wms_delete_input_set_memory_storage (input, ctx->storage, NULL);
+                qmi_message_wms_delete_input_set_memory_index (input, ctx->index, NULL);
+                qmi_message_wms_delete_input_set_message_mode (input, QMI_WMS_MESSAGE_MODE_GSM_WCDMA, NULL);
+                qmi_client_wms_delete (QMI_CLIENT_WMS (client),
+                                       input,
+                                       5,
+                                       NULL,
+                                       (GAsyncReadyCallback)imsroha_port_part_delete_ready,
+                                       g_object_ref (ctx->self));
+            }
+        }
+    }
+
+    g_object_unref (ctx->self);
+    g_slice_free (ImsrohaPortPartContext, ctx);
+}
+
+/* TRUE if the part (a 3GPP one) was handed to imsroha and is no longer the caller's. */
+static gboolean
+imsroha_take_port_part (MMBroadbandModemQmi  *self,
+                        MMSmsPart            *part,
+                        QmiWmsStorageType     storage,
+                        guint32               index,
+                        QmiWmsMessageTagType  tag,
+                        gboolean              transfer_route,
+                        GArray               *data)
+{
+    MMImsBackendImsroha    *backend;
+    ImsrohaPortPartContext *ctx;
+    g_autofree gchar       *hexpdu = NULL;
+    g_autoptr(GError)       error = NULL;
+    gint                    port;
+
+    backend = mm_broadband_modem_qmi_peek_ims_backend (self);
+    if (!backend)
+        return FALSE;
+
+    port = mm_sms_part_get_destination_port (part);
+    if (port < 0 || mm_sms_part_get_pdu_type (part) != MM_SMS_PDU_TYPE_DELIVER)
+        return FALSE;
+    if (port == 2948 || port == 2949)
+        return FALSE;
+
+    hexpdu = mm_sms_part_3gpp_get_tpdu_hex ((const guint8 *)data->data, data->len, transfer_route, &error);
+    if (!hexpdu) {
+        mm_obj_dbg (self, "keeping SMS part for application port %d as a message: %s", port, error->message);
+        return FALSE;
+    }
+
+    mm_obj_info (self, "received SMS part for application port %d: for imsroha, not the SMS list", port);
+    ctx = g_slice_new0 (ImsrohaPortPartContext);
+    ctx->self = g_object_ref (self);
+    ctx->part = part;
+    ctx->storage = storage;
+    ctx->index = index;
+    ctx->tag = tag;
+    ctx->port = (guint16)port;
+    mm_ims_backend_imsroha_take_port_pdu (backend,
+                                          ctx->port,
+                                          hexpdu,
+                                          NULL,
+                                          (GAsyncReadyCallback)imsroha_take_port_pdu_ready,
+                                          ctx);
+    return TRUE;
+}
+
 static void
 add_new_read_sms_part (MMIfaceModemMessaging *self,
                        QmiWmsStorageType storage,
@@ -8075,6 +8209,10 @@ add_new_read_sms_part (MMIfaceModemMessaging *self,
 
     if (part) {
         mm_obj_dbg (self, "correctly parsed PDU (%d)", index);
+        if (format == QMI_WMS_MESSAGE_FORMAT_GSM_WCDMA_POINT_TO_POINT &&
+            imsroha_take_port_part (MM_BROADBAND_MODEM_QMI (self), part, storage, index, tag,
+                                    transfer_route, data))
+            return;
         mm_iface_modem_messaging_take_part (self,
                                             part,
                                             mm_sms_state_from_qmi_message_tag (tag),
diff --git a/src/mm-ims-backend-imsroha.c b/src/mm-ims-backend-imsroha.c
index e6decdd..eb47b53 100644
--- a/src/mm-ims-backend-imsroha.c
+++ b/src/mm-ims-backend-imsroha.c
@@ -754,6 +754,66 @@ mm_ims_backend_imsroha_send_sms_finish (MMImsBackendImsroha  *self,
     return TRUE;
 }
 
+/*****************************************************************************/
+/* Port-addressed SMS the modem received: for applications, through imsroha's
+ * PortPduReceived, not for the SMS list. */
+
+static void
+dbus_take_port_pdu_ready (GDBusConnection *connection,
+                          GAsyncResult    *res,
+                          GTask           *task)
+{
+    GError *error = NULL;
+    g_autoptr(GVariant) reply = NULL;
+
+    reply = g_dbus_connection_call_finish (connection, res, &error);
+    if (!reply)
+        g_task_return_error (task, error);
+    else
+        g_task_return_boolean (task, TRUE);
+    g_object_unref (task);
+}
+
+void
+mm_ims_backend_imsroha_take_port_pdu (MMImsBackendImsroha *self,
+                                      guint16              port,
+                                      const gchar         *hexpdu,
+                                      GCancellable        *cancellable,
+                                      GAsyncReadyCallback  callback,
+                                      gpointer             user_data)
+{
+    GTask *task;
+
+    task = g_task_new (self, cancellable, callback, user_data);
+    if (!self->priv->is_available || !self->priv->connection) {
+        g_task_return_new_error (task, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                                 "imsroha is not available");
+        g_object_unref (task);
+        return;
+    }
+
+    g_dbus_connection_call (self->priv->connection,
+                            "codes.noa.IMSroha",
+                            "/codes/noa/IMSroha",
+                            "codes.noa.IMSroha",
+                            "TakePortPdu",
+                            g_variant_new ("(qs)", port, hexpdu),
+                            G_VARIANT_TYPE ("()"),
+                            G_DBUS_CALL_FLAGS_NONE,
+                            10000,
+                            cancellable,
+                            (GAsyncReadyCallback) dbus_take_port_pdu_ready,
+                            task);
+}
+
+gboolean
+mm_ims_backend_imsroha_take_port_pdu_finish (MMImsBackendImsroha  *self,
+                                             GAsyncResult         *res,
+                                             GError              **error)
+{
+    return g_task_propagate_boolean (G_TASK (res), error);
+}
+
 /*****************************************************************************/
 
 GList *
