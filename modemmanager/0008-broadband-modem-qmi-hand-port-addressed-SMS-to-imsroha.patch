+/********************* APPLICATION PORT TESTS *********************/
+
+/* SMSC +821019000, then an SMS-DELIVER from 1234 with UDHI, UCS-2, UDH
+ * 06 05 04 9199 0000 (16-bit ports, destination 37273, source 0) and the
+ * text "123456": the RCS OTP of TTAK.KO-06.0410/R9 6.3.1.1.2. */
+static const guint8 port16_pdu[] = {
+    0x06, 0x91, 0x28, 0x01, 0x91, 0x00, 0xf0,
+    0x40, 0x04, 0x81, 0x21, 0x43, 0x00, 0x08,
+    0x52, 0x11, 0x11, 0x31, 0x00, 0x00, 0x00,
+    0x13,
+    0x06, 0x05, 0x04, 0x91, 0x99, 0x00, 0x00,
+    0x00, 0x31, 0x00, 0x32, 0x00, 0x33, 0x00, 0x34, 0x00, 0x35, 0x00, 0x36 };
+
+#define PORT16_TPDU_HEX \
+    "00" "40" "04" "81" "2143" "00" "08" "52111131000000" "13" \
+    "06050491990000" "003100320033003400350036"
+
+static void
+test_pdu_port_16bit (void)
+{
+    MMSmsPart *part;
+    GError    *error = NULL;
+    gchar     *hex;
+
+    part = mm_sms_part_3gpp_new_from_binary_pdu (0, port16_pdu, sizeof (port16_pdu), NULL, FALSE, &error);
+    g_assert_no_error (error);
+    g_assert_nonnull (part);
+    g_assert_cmpint (mm_sms_part_get_destination_port (part), ==, 37273);
+    g_assert_cmpstr (mm_sms_part_get_smsc (part), ==, "+821019000");
+    g_assert_cmpstr (mm_sms_part_get_text (part), ==, "123456");
+    g_assert_cmpuint (mm_sms_part_get_pdu_type (part), ==, MM_SMS_PDU_TYPE_DELIVER);
+    g_assert_false (mm_sms_part_should_concat (part));
+    mm_sms_part_free (part);
+
+    /* What goes to imsroha: no SMSC address, then the TPDU */
+    hex = mm_sms_part_3gpp_get_tpdu_hex (port16_pdu, sizeof (port16_pdu), FALSE, &error);
+    g_assert_no_error (error);
+    g_assert_cmpstr (hex, ==, PORT16_TPDU_HEX);
+    g_free (hex);
+
+    /* Transfer-route messages come without the SMSC address */
+    hex = mm_sms_part_3gpp_get_tpdu_hex (port16_pdu + 7, sizeof (port16_pdu) - 7, TRUE, &error);
+    g_assert_no_error (error);
+    g_assert_cmpstr (hex, ==, PORT16_TPDU_HEX);
+    g_free (hex);
+
+    /* And the converted PDU parses the same */
+    part = mm_sms_part_3gpp_new_from_pdu (0, PORT16_TPDU_HEX, NULL, &error);
+    g_assert_no_error (error);
+    g_assert_cmpint (mm_sms_part_get_destination_port (part), ==, 37273);
+    g_assert_null (mm_sms_part_get_smsc (part));
+    mm_sms_part_free (part);
+}
+
+static void
+test_pdu_port_8bit (void)
+{
+    /* No SMSC, 8-bit data, UDH 04 04 02 10 00 (8-bit ports, destination 16), 3 data octets */
+    static const guint8 pdu[] = {
+        0x00,
+        0x40, 0x04, 0x81, 0x21, 0x43, 0x00, 0x04,
+        0x52, 0x11, 0x11, 0x31, 0x00, 0x00, 0x00,
+        0x08,
+        0x04, 0x04, 0x02, 0x10, 0x00,
+        0x01, 0x02, 0x03 };
+    static const guint8 expected_data[] = { 0x01, 0x02, 0x03 };
+    MMSmsPart        *part;
+    GError           *error = NULL;
+    const GByteArray *data;
+
+    part = mm_sms_part_3gpp_new_from_binary_pdu (0, pdu, sizeof (pdu), NULL, FALSE, &error);
+    g_assert_no_error (error);
+    g_assert_nonnull (part);
+    g_assert_cmpint (mm_sms_part_get_destination_port (part), ==, 16);
+    data = mm_sms_part_get_data (part);
+    g_assert_nonnull (data);
+    g_assert_cmpmem (data->data, data->len, expected_data, sizeof (expected_data));
+    mm_sms_part_free (part);
+}
+
+static void
+test_pdu_port_wap_push (void)
+{
+    /* MMS notification: 8-bit data, UDH 06 05 04 0b84 23f0 */
+    static const gchar *hexpdu =
+        "00" "40" "04" "81" "2143" "00" "04" "52111131000000" "0a"
+        "0605040b8423f0" "010203";
+    MMSmsPart *part;
+    GError    *error = NULL;
+
+    part = mm_sms_part_3gpp_new_from_pdu (0, hexpdu, NULL, &error);
+    g_assert_no_error (error);
+    g_assert_cmpint (mm_sms_part_get_destination_port (part), ==, 2948);
+    mm_sms_part_free (part);
+}
+
+static void
+test_pdu_port_with_concat (void)
+{
+    /* UDH 0b 00 03 2a 02 01 05 04 9199 0000: part 1 of 2, ref 0x2a, then port 37273 */
+    static const gchar *hexpdu =
+        "00" "40" "04" "81" "2143" "00" "04" "52111131000000" "0e"
+        "0b0003" "2a0201" "050491990000" "0102";
+    MMSmsPart *part;
+    GError    *error = NULL;
+
+    part = mm_sms_part_3gpp_new_from_pdu (0, hexpdu, NULL, &error);
+    g_assert_no_error (error);
+    g_assert_cmpint (mm_sms_part_get_destination_port (part), ==, 37273);
+    g_assert_true (mm_sms_part_should_concat (part));
+    g_assert_cmpuint (mm_sms_part_get_concat_reference (part), ==, 0x2a);
+    g_assert_cmpuint (mm_sms_part_get_concat_max (part), ==, 2);
+    g_assert_cmpuint (mm_sms_part_get_concat_sequence (part), ==, 1);
+    mm_sms_part_free (part);
+}
+
+static void
+test_pdu_port_none (void)
+{
+    /* A plain 7-bit "hello" without a UDH, and a 16-bit port IE of the wrong length */
+    static const gchar *plain = "00" "04" "0591" "2801f0" "00" "00" "52111131000000" "05" "e8329bfd06";
+    static const gchar *bad_ie =
+        "00" "40" "04" "81" "2143" "00" "04" "52111131000000" "08"
+        "050503919900" "0102";
+    MMSmsPart *part;
+    GError    *error = NULL;
+
+    part = mm_sms_part_3gpp_new_from_pdu (0, plain, NULL, &error);
+    g_assert_no_error (error);
+    g_assert_cmpint (mm_sms_part_get_destination_port (part), ==, -1);
+    mm_sms_part_free (part);
+
+    part = mm_sms_part_3gpp_new_from_pdu (0, bad_ie, NULL, &error);
+    g_assert_no_error (error);
+    g_assert_cmpint (mm_sms_part_get_destination_port (part), ==, -1);
+    mm_sms_part_free (part);
+}
+
+static void
+test_tpdu_hex_too_short (void)
+{
+    static const guint8 smsc_only[] = { 0x06, 0x91, 0x28, 0x01, 0x91, 0x00, 0xf0 };
+    GError *error = NULL;
+    gchar  *hex;
+
+    hex = mm_sms_part_3gpp_get_tpdu_hex (smsc_only, sizeof (smsc_only), FALSE, &error);
+    g_assert_null (hex);
+    g_assert_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED);
+    g_clear_error (&error);
+
+    hex = mm_sms_part_3gpp_get_tpdu_hex (smsc_only, 0, TRUE, &error);
+    g_assert_null (hex);
+    g_assert_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED);
+    g_clear_error (&error);
+}
