 #endif /* MM_IMS_BACKEND_IMSROHA_H */
diff --git a/src/mm-sms-part-3gpp.c b/src/mm-sms-part-3gpp.c
index d91946c..9b1e85d 100644
--- a/src/mm-sms-part-3gpp.c
+++ b/src/mm-sms-part-3gpp.c
@@ -368,6 +368,40 @@ mm_sms_part_3gpp_new_from_pdu (guint         index,
     return mm_sms_part_3gpp_new_from_binary_pdu (index, pdu, pdu_len, log_object, FALSE, error);
 }
 
+gchar *
+mm_sms_part_3gpp_get_tpdu_hex (const guint8  *pdu,
+                               gsize          pdu_len,
+                               gboolean       transfer_route,
+                               GError       **error)
+{
+    GString *hex;
+    gsize    offset = 0;
+    gsize    i;
+
+    /* Stored and read messages start with the SMSC address; transfer-route
+     * ones are the bare TPDU. */
+    if (!transfer_route) {
+        if (pdu_len < 1) {
+            g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                         "PDU too short, cannot read SMSC address length");
+            return NULL;
+        }
+        offset = 1 + pdu[0];
+    }
+    if (offset >= pdu_len) {
+        g_set_error (error, MM_CORE_ERROR, MM_CORE_ERROR_FAILED,
+                     "PDU too short, no TPDU after the SMSC address: %" G_GSIZE_FORMAT " <= %" G_GSIZE_FORMAT,
+                     pdu_len, offset);
+        return NULL;
+    }
+
+    hex = g_string_sized_new (2 + 2 * (pdu_len - offset));
+    g_string_append (hex, "00");
+    for (i = offset; i < pdu_len; i++)
+        g_string_append_printf (hex, "%02x", pdu[i]);
+    return g_string_free (hex, FALSE);
+}
+
 MMSmsPart *
 mm_sms_part_3gpp_new_from_binary_pdu (guint         index,
                                       const guint8  *pdu,
@@ -738,6 +772,21 @@ mm_sms_part_3gpp_new_from_binary_pdu (guint         index,
                     mm_sms_part_set_concat_max (sms_part,pdu[offset + 2]);
                     mm_sms_part_set_concat_sequence (sms_part, pdu[offset + 3]);
                     break;
+                case 0x04:
+                    /* Application port addressing, 8-bit (TS 23.040 9.2.3.24.4) */
+                    if (ie_len != 2 || offset + 2 > end)
+                        break;
+                    mm_sms_part_set_destination_port (sms_part, pdu[offset]);
+                    mm_obj_dbg (log_object, "  destination port: %u (8-bit)", (guint)pdu[offset]);
+                    break;
+                case 0x05:
+                    /* Application port addressing, 16-bit (TS 23.040 9.2.3.24.5) */
+                    if (ie_len != 4 || offset + 4 > end)
+                        break;
+                    mm_sms_part_set_destination_port (sms_part, (pdu[offset] << 8) | pdu[offset + 1]);
+                    mm_obj_dbg (log_object, "  destination port: %u (16-bit)",
+                                (guint)((pdu[offset] << 8) | pdu[offset + 1]));
+                    break;
                 default:
                     break;
                 }
