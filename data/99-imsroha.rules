# SPDX-License-Identifier: GPL-3.0-only
ACTION!="add|change", GOTO="imsroha_rules_end"

# The IMS PDN's rmnet link belongs to imsroha-bearer: ModemManager must not
# take it as a data port. ims-netdev= in imsroha.conf names it (default imsroha0).
SUBSYSTEM=="net", KERNEL=="imsroha*", ENV{ID_MM_PORT_IGNORE}="1"

# ModemManager hands voice and messaging to imsroha on modems with this tag.
# Qualcomm SoC modems get it here. For a USB or PCIe modem, tag its ports in
# a rule of your own (and set qmi-device= in imsroha.conf), for example:
#   SUBSYSTEMS=="usb", ATTRS{idVendor}=="2c7c", ATTRS{idProduct}=="0125", ENV{ID_MM_IMSROHA}="1"
#   SUBSYSTEMS=="pci", ATTRS{vendor}=="0x17cb", ATTRS{device}=="0x0308", ENV{ID_MM_IMSROHA}="1"
ENV{ID_MM_QCOM_SOC}=="1", ENV{ID_MM_IMSROHA}="1"

LABEL="imsroha_rules_end"
