+QCoro::Task<void> ChannelLogger::resendSuggestionResponseTask(const QString id)
+{
+    const auto found = co_await m_database.messagesForNumber(PhoneNumberList(), id);
+    if (found.empty() || found.front().richContentType != BOT_RESPONSE_TYPE || !found.front().sentByMe) {
         co_return;
     }
+    Message message = found.front();
+    co_await m_database.updateMessageDeliveryState(id, MessageState::Pending);
+    message.deliveryStatus = MessageState::Pending;
+    updateMessage(message);
+    co_await sendSuggestionResponseRow(message);
+}
+
+QCoro::Task<void> ChannelLogger::sendSuggestionResponseRow(Message message)
+{
+    // the same response to the same message, over RCS or not at all: as SMS
+    // the bot would get the label without its postback (R9 7.7.3.1)
+    const auto rcsId = co_await m_rcs.sendSuggestionResponse(message.phoneNumberList.first().toE164(), message.inReplyTo, message.richBody);
     if (rcsId) {
-        co_await m_database.updateMessageSent(id, *rcsId, QString());
+        co_await m_database.updateMessageSent(message.id, *rcsId, QString());
     } else {
-        // never as SMS: the bot would get the label without its postback
-        co_await m_database.updateMessageDeliveryState(id, MessageState::Failed);
+        co_await m_database.updateMessageDeliveryState(message.id, MessageState::Failed);
         message.deliveryStatus = MessageState::Failed;
         updateMessage(message);
     }
 }
 
+QCoro::Task<bool> ChannelLogger::isChatbotConversation(const PhoneNumberList phoneNumberList)
+{
+    if (isChatbotUri(phoneNumberList)) {
+        co_return true;
+    }
+    if (phoneNumberList.size() != 1) {
+        co_return false;
+    }
+    const QString botId = co_await m_database.botIdForNumber(phoneNumberList);
+    co_return !botId.isEmpty();
+}
