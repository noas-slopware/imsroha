+    // A tapped suggestion of a chatbot message: do what it says, then tell
+    // the bot (RCC.07 3.6.10.6.2). What Spacebar cannot do goes nowhere.
+    function runSuggestion(id, s) {
+        const notify = text => applicationWindow().showPassiveNotification(text)
+        const open = url => !!url && Qt.openUrlExternally(url)
+        let done = true
+        switch (s.action) {
+        case "reply":
+            break
+        case "url":
+        case "localBrowser": // R9's in-app browser: the browser, without its result
+        case "deeplink":
+            done = open(s.url)
+            break
+        case "dial":
+            done = open(s.phoneNumber ? "tel:" + s.phoneNumber : "") || open(s.fallbackUrl)
+            break
+        case "map": {
+            const geo = s.latitude !== undefined
+                ? "geo:" + s.latitude + "," + s.longitude + (s.label ? "?q=" + s.latitude + "," + s.longitude + "(" + encodeURIComponent(s.label) + ")" : "")
+                : "geo:0,0?q=" + encodeURIComponent(s.query || "")
+            done = open(geo) || open(s.fallbackUrl)
+            break
+        }
+        case "calendar":
+            done = open(messageModel.calendarFile(s)) || open(s.fallbackUrl)
+            break
+        case "compose":
+            if (!s.phoneNumber || (people.length === 1 && Utils.phoneNumberToInternationalString(Utils.phoneNumber(s.phoneNumber)) === people[0].phoneNumber)) {
+                textarea.text = s.text || ""
+            } else {
+                Utils.copyTextToClipboard(s.text || "")
+                ChatListModel.startChat(Utils.phoneNumberList([s.phoneNumber]))
+                notify(i18nc("@info a chatbot's draft message", "The draft was copied to the clipboard"))
+            }
+            break
+        case "copy":
+            Utils.copyTextToClipboard(s.text || "")
+            notify(i18nc("@info", "Copied to the clipboard"))
+            break
+        case "share":
+            // no share service here: the text goes to the clipboard to paste
+            Utils.copyTextToClipboard(s.text || "")
+            notify(i18nc("@info a chatbot's text to share", "Copied to the clipboard, to share"))
+            break
+        default:
+            // location push, device specifics, settings, recordings
+            notify(i18nc("@info a chatbot's suggested action", "Spacebar cannot do this"))
+            done = false
+        }
+        if (!done && s.action !== "reply") {
+            if (s.action === "url" || s.action === "dial" || s.action === "map" || s.action === "calendar" || s.action === "localBrowser" || s.action === "deeplink") {
+                notify(i18nc("@info", "No application can open this"))
+            }
+            return
+        }
+        messageModel.sendSuggestion(id, s.raw)
