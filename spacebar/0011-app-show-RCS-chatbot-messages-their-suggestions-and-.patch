diff --git a/src/richmedia.cpp b/src/richmedia.cpp
new file mode 100644
index 0000000..890065c
--- /dev/null
+++ b/src/richmedia.cpp
@@ -0,0 +1,94 @@
+// SPDX-FileCopyrightText: 2026 Noa Himesaka <himesaka@noa.codes>
+//
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+#include "richmedia.h"
+
+#include <QCryptographicHash>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QNetworkAccessManager>
+#include <QNetworkReply>
+#include <QNetworkRequest>
+#include <QRegularExpression>
+#include <QUrl>
+
+#include <global.h>
+
+// Pictures only: a card's video is opened, not fetched.
+constexpr qint64 MAX_SIZE = 10 * 1024 * 1024;
+
+RichMedia::RichMedia(QNetworkAccessManager *network, QObject *parent)
+    : QObject(parent)
+    , m_network(network)
+{
+}
+
+QString RichMedia::pathFor(const QString &url, const QString &folder)
+{
+    // the URL's suffix when it looks like one, for the image reader
+    QString suffix = QFileInfo(QUrl(url).path()).suffix().toLower();
+    static const QRegularExpression plain(SL("^[a-z0-9]{1,5}$"));
+    if (!plain.match(suffix).hasMatch()) {
+        suffix.clear();
+    }
+    const QString name = QString::fromLatin1(QCryptographicHash::hash(url.toUtf8(), QCryptographicHash::Sha1).toHex());
+    return folder + SL("/rbm/") + name + (suffix.isEmpty() ? QString() : SL(".") + suffix);
+}
+
+QString RichMedia::localFile(const QString &url, const QString &folder)
+{
+    const QUrl remote(url);
+    if (folder.isEmpty() || !remote.isValid() || (remote.scheme() != u"https" && remote.scheme() != u"http") || remote.host().isEmpty()) {
+        return {};
+    }
+    const QString path = pathFor(url, folder);
+    if (QFileInfo::exists(path)) {
+        return QUrl::fromLocalFile(path).toString();
+    }
+    if (m_pending.contains(path) || m_failed.contains(path)) {
+        return {};
+    }
+    m_pending.insert(path);
+
+    QNetworkRequest request(remote);
+    request.setAttribute(QNetworkRequest::RedirectPolicyAttribute, QNetworkRequest::NoLessSafeRedirectPolicy);
+    request.setTransferTimeout(30000);
+    QNetworkReply *reply = m_network->get(request);
+    connect(reply, &QNetworkReply::downloadProgress, reply, [reply](qint64 received, qint64 total) {
+        if (received > MAX_SIZE || total > MAX_SIZE) {
+            reply->abort();
+        }
+    });
+    connect(reply, &QNetworkReply::finished, this, [this, reply, url, path] {
+        finished(reply, url, path);
+    });
+    return {};
+}
+
+void RichMedia::finished(QNetworkReply *reply, const QString &url, const QString &path)
+{
+    reply->deleteLater();
+    m_pending.remove(path);
+    const QByteArray data = reply->error() == QNetworkReply::NoError ? reply->readAll() : QByteArray();
+    if (data.isEmpty()) {
+        qDebug() << "RCS chatbot media" << url << "not fetched:" << reply->errorString();
+        m_failed.insert(path);
+        return;
+    }
+    QDir().mkpath(QFileInfo(path).absolutePath());
+    QFile file(path + SL(".part"));
+    if (!file.open(QIODevice::WriteOnly) || file.write(data) != data.size()) {
+        m_failed.insert(path);
+        return;
+    }
+    file.close();
+    QFile::remove(path);
+    if (!QFile::rename(file.fileName(), path)) {
+        QFile::remove(file.fileName());
+        m_failed.insert(path);
+        return;
+    }
+    Q_EMIT fetched(url, QUrl::fromLocalFile(path).toString());
+}
