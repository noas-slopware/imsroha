@@ -0,0 +1,43 @@
+// SPDX-FileCopyrightText: 2026 Noa Himesaka <himesaka@noa.codes>
+//
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+#pragma once
+
+#include <QHash>
+#include <QObject>
+#include <QSet>
+
+class QNetworkAccessManager;
+class QNetworkReply;
+
+/*
+ * Pictures of RCS chatbot messages (rich card media and thumbnails, open
+ * rich card images, chatbot icons), fetched over HTTP(S) once and kept in
+ * the conversation's attachment folder under rbm/, named by the URL's hash.
+ */
+class RichMedia : public QObject
+{
+    Q_OBJECT
+
+public:
+    explicit RichMedia(QNetworkAccessManager *network, QObject *parent = nullptr);
+
+    /*
+     * The local file:// URL of url when it is here already. Otherwise ""
+     * and the download starts; fetched() follows when it is done.
+     * folder is the conversation's attachment folder.
+     */
+    Q_INVOKABLE QString localFile(const QString &url, const QString &folder);
+
+Q_SIGNALS:
+    void fetched(const QString &url, const QString &localUrl);
+
+private:
+    static QString pathFor(const QString &url, const QString &folder);
+    void finished(QNetworkReply *reply, const QString &url, const QString &path);
+
+    QNetworkAccessManager *m_network;
+    QSet<QString> m_pending; // paths being fetched
+    QSet<QString> m_failed; // and those that failed this run, not asked again
+};
