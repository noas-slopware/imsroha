+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as Controls
+
+import org.kde.kirigami as Kirigami
+
+// One suggested reply or suggested action of an RCS chatbot (RCC.07
+// 3.6.10.6): a chip under the message, or a button in a card.
+Controls.Button {
+    id: root
+
+    // normalised by RichMessage::parse(): type, action, displayText, raw...
+    property var suggestion: ({})
+    // a chip of the chip list (rounded, outlined) rather than a card's button
+    property bool chip: true
+
+    signal triggered(var suggestion)
+
+    readonly property string kind: suggestion.action || ""
+
+    text: suggestion.displayText || suggestion.url || suggestion.phoneNumber || suggestion.text || ""
+    icon.name: {
+        switch (kind) {
+        case "url":
+        case "localBrowser":
+        case "deeplink":
+            return "internet-web-browser-symbolic"
+        case "dial":
+            return suggestion.video ? "camera-video-symbolic" : "call-start-symbolic"
+        case "map":
+        case "locationPush":
+            return "mark-location-symbolic"
+        case "calendar":
+            return "view-calendar-symbolic"
+        case "compose":
+        case "composeRecording":
+            return "document-edit-symbolic"
+        case "copy":
+            return "edit-copy-symbolic"
+        case "share":
+            return "emblem-shared-symbolic"
+        default:
+            return ""
+        }
+    }
+    icon.width: Kirigami.Units.iconSizes.small
+    icon.height: Kirigami.Units.iconSizes.small
+    flat: !chip
+    Accessible.name: text
+
+    background: Rectangle {
+        visible: root.chip || root.down || root.hovered
+        radius: root.chip ? height / 2 : Kirigami.Units.smallSpacing
+        color: root.down ? Kirigami.ColorUtils.tintWithAlpha(Kirigami.Theme.backgroundColor, Kirigami.Theme.highlightColor, 0.3)
+             : root.chip ? Kirigami.Theme.backgroundColor
+             : Kirigami.ColorUtils.tintWithAlpha(Kirigami.Theme.backgroundColor, Kirigami.Theme.highlightColor, 0.1)
+        border.width: root.chip ? 1 : 0
+        border.color: Kirigami.ColorUtils.tintWithAlpha(Kirigami.Theme.backgroundColor, Kirigami.Theme.highlightColor, 0.6)
+    }
+    contentItem: RowLayout {
+        spacing: Kirigami.Units.smallSpacing
+
+        Kirigami.Icon {
+            visible: !!root.icon.name
+            Layout.preferredWidth: root.icon.width
+            Layout.preferredHeight: root.icon.height
+            source: root.icon.name
+            color: Kirigami.Theme.highlightColor
+        }
+        Controls.Label {
+            Layout.fillWidth: true
+            text: root.text
+            color: Kirigami.Theme.highlightColor
+            elide: Text.ElideRight
+        }
+    }
+    leftPadding: Kirigami.Units.largeSpacing
+    rightPadding: Kirigami.Units.largeSpacing
+    topPadding: Kirigami.Units.smallSpacing * 1.5
+    bottomPadding: Kirigami.Units.smallSpacing * 1.5
+
+    onClicked: triggered(suggestion)
+}
