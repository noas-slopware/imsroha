+
+void MessageModel::sendSuggestion(const QString &id, const QVariantMap &suggestion)
+{
+    const QJsonObject raw = QJsonObject::fromVariantMap(suggestion);
+    QString replyId;
+    if (RichMessage::isReply(raw)) {
+        // shown at once, as sendMessage does; the daemon stores it under this id
+        Message message;
+        message.id = Database::generateRandomId();
+        message.phoneNumberList = m_phoneNumberList;
+        message.text = RichMessage::displayText(raw);
+        message.sentByMe = true;
+        message.deliveryStatus = MessageState::Pending;
+        message.transport = SL("rcs");
+        message.datetime = QDateTime::currentDateTime();
+        replyId = message.id;
+
+        beginInsertRows({}, m_messages.size(), m_messages.size());
+        m_messages.insert(m_messages.begin(), message);
+        endInsertRows();
+    }
+    m_handler.interface()->sendSuggestionResponse(m_phoneNumberList.toString(),
+                                                  replyId,
+                                                  id,
+                                                  QString::fromUtf8(QJsonDocument(raw).toJson(QJsonDocument::Compact)));
+    if (!replyId.isEmpty()) {
+        Q_EMIT m_handler.messagesChanged(m_phoneNumberList);
+    }
+}
+
+QString MessageModel::calendarFile(const QVariantMap &event) const
+{
+    // RFC 5545; the times come as ISO 8601 (RCC.07)
+    auto stamp = [](const QString &iso) {
+        const QDateTime t = QDateTime::fromString(iso, Qt::ISODateWithMs);
+        return t.isValid() ? t.toUTC().toString(SL("yyyyMMdd'T'HHmmss'Z'")) : QString();
+    };
+    auto escaped = [](QString text) {
+        text.replace(u'\\', SL("\\\\"));
+        text.replace(u';', SL("\\;"));
+        text.replace(u',', SL("\\,"));
+        text.replace(u'\n', SL("\\n"));
+        return text;
+    };
+    const QString start = stamp(event.value(SL("startTime")).toString());
+    const QString end = stamp(event.value(SL("endTime")).toString());
+    if (start.isEmpty() || end.isEmpty()) {
+        return {};
+    }
+    const QString uid = Database::generateRandomId();
+    QStringList lines{SL("BEGIN:VCALENDAR"),
+                      SL("VERSION:2.0"),
+                      SL("PRODID:-//KDE//Spacebar//EN"),
+                      SL("BEGIN:VEVENT"),
+                      SL("UID:") + uid + SL("@spacebar"),
+                      SL("DTSTAMP:") + QDateTime::currentDateTimeUtc().toString(SL("yyyyMMdd'T'HHmmss'Z'")),
+                      SL("DTSTART:") + start,
+                      SL("DTEND:") + end,
+                      SL("SUMMARY:") + escaped(event.value(SL("title")).toString())};
+    const QString description = event.value(SL("description")).toString();
+    if (!description.isEmpty()) {
+        lines.append(SL("DESCRIPTION:") + escaped(description));
+    }
+    lines << SL("END:VEVENT") << SL("END:VCALENDAR");
+
+    const QString folder = attachmentsFolder() + SL("/rbm");
+    QDir().mkpath(folder);
+    QFile file(folder + SL("/") + uid + SL(".ics"));
+    if (!file.open(QIODevice::WriteOnly)) {
+        return {};
+    }
+    file.write((lines.join(SL("\r\n")) + SL("\r\n")).toUtf8());
+    return QUrl::fromLocalFile(file.fileName()).toString();
+}
