new file mode 100644
index 0000000..8d64aac
--- /dev/null
+++ b/src/contents/ui/OpenRichNode.qml
@@ -0,0 +1,262 @@
+// SPDX-FileCopyrightText: 2026 Noa Himesaka <himesaka@noa.codes>
+//
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as Controls
+
+import org.kde.kirigami as Kirigami
+
+// One widget of an R9 open rich card (TTAK.KO-06.0410/R9 7.7.4.14):
+// LinearLayout, TextView, ImageView, Button or View, and its children.
+// dp is taken as a logical pixel.
+Item {
+    id: node
+
+    // the widget as RichMessage::parse() left it (clicks normalised)
+    property var widget: ({})
+    property string folder
+    property color textColor: Kirigami.Theme.textColor
+    // the width "match" takes
+    property real availableWidth: 0
+    property bool isRoot: false
+
+    signal suggestionTriggered(var suggestion)
+    signal imageClicked(string localUrl, var widget)
+
+    readonly property string type: widget.widget || ""
+
+    function dp(value, fallback) {
+        if (typeof value === "number") {
+            return value
+        }
+        const m = /^\s*(-?[0-9.]+)\s*(dp)?\s*$/.exec(value || "")
+        return m ? parseFloat(m[1]) : fallback
+    }
+    function side(name) {
+        // "padding"/"margin" set: the sides are ignored (R9 table 7-9)
+        const all = dp(widget[name], NaN)
+        if (!isNaN(all)) {
+            return { top: all, bottom: all, left: all, right: all }
+        }
+        return {
+            top: dp(widget[name + "Top"], 0),
+            bottom: dp(widget[name + "Bottom"], 0),
+            left: dp(widget[name + "Left"], dp(widget[name + "Start"], 0)),
+            right: dp(widget[name + "Right"], dp(widget[name + "End"], 0))
+        }
+    }
+    function colour(value, fallback) {
+        // #RRGGBB or #AARRGGBB; "bot_color" would be the bot's colour
+        return /^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$/.test(value || "") ? value : fallback
+    }
+
+    readonly property var margin: side("margin")
+    readonly property var padding: side("padding")
+    readonly property real horizontalExtra: margin.left + margin.right + padding.left + padding.right
+    readonly property real verticalExtra: margin.top + margin.bottom + padding.top + padding.bottom
+    // the root's width is always "match"
+    readonly property string widthSpec: isRoot ? "match" : String(widget.width || "content")
+    readonly property real fixedWidth: dp(widthSpec, NaN)
+    readonly property real fixedHeight: dp(widget.height, NaN)
+    readonly property real contentWidth: widthSpec === "match" ? Math.max(0, availableWidth - horizontalExtra)
+                                       : !isNaN(fixedWidth) ? fixedWidth
+                                       : Math.min(inner.item ? (inner.item as Item).implicitWidth : 0, Math.max(0, availableWidth - horizontalExtra))
+
+    visible: widget.visibility !== "gone"
+    opacity: widget.visibility === "invisible" ? 0 : 1
+
+    implicitWidth: contentWidth + horizontalExtra
+    implicitHeight: (!isNaN(fixedHeight) ? fixedHeight : (inner.item ? (inner.item as Item).implicitHeight : 0)) + verticalExtra
+
+    Rectangle {
+        id: frame
+        x: node.margin.left
+        y: node.margin.top
+        width: Math.max(0, node.width - node.margin.left - node.margin.right)
+        height: Math.max(0, node.height - node.margin.top - node.margin.bottom)
+        color: node.colour(node.widget.background, "transparent")
+        radius: node.dp(node.widget.corner_radius, node.dp(node.widget.corner_radious, 0))
+        clip: node.type === "ImageView"
+
+        Loader {
+            id: inner
+            x: node.padding.left
+            y: node.padding.top
+            width: Math.max(0, parent.width - node.padding.left - node.padding.right)
+            height: Math.max(0, parent.height - node.padding.top - node.padding.bottom)
+            sourceComponent: {
+                switch (node.type) {
+                case "LinearLayout":
+                    return linear
+                case "TextView":
+                    return textView
+                case "Button":
+                    return button
+                case "ImageView":
+                    return imageView
+                default:
+                    return null // View: a gap or a line, its background is all
+                }
+            }
+        }
+    }
+
+    // a click on any widget but a Button, which takes it itself
+    MouseArea {
+        anchors.fill: parent
+        enabled: !!node.widget.click && node.type !== "Button" && node.type !== "ImageView"
+        onClicked: node.suggestionTriggered(node.widget.click)
+    }
+
+    // R9: weight shares what the other children left; in a vertical layout
+    // the height is then ignored, in a horizontal one the width
+    component Child: Loader {
+        required property var modelData
+        required property bool vertical
+        readonly property real weight: Number(modelData.weight) || 0
+        source: "qrc:/OpenRichNode.qml"
+        Layout.fillWidth: vertical || weight > 0 || String(modelData.width) === "match"
+        Layout.horizontalStretchFactor: !vertical && weight > 0 ? Math.round(weight * 100) : -1
+        Layout.preferredWidth: !vertical && weight > 0 ? 0 : -1
+        Layout.alignment: vertical ? Qt.AlignLeft | Qt.AlignTop : Qt.AlignVCenter
+        onLoaded: {
+            const child = item as OpenRichNode
+            child.widget = Qt.binding(() => modelData)
+            child.folder = Qt.binding(() => node.folder)
+            child.textColor = Qt.binding(() => node.textColor)
+            // a child's "match" is this layout's width
+            child.availableWidth = Qt.binding(() => inner.width)
+            child.suggestionTriggered.connect(node.suggestionTriggered)
+            child.imageClicked.connect(node.imageClicked)
+        }
+    }
+
+    Component {
+        id: linear
+
+        Loader {
+            sourceComponent: node.widget.orientation === "horizontal" ? row : column
+        }
+    }
+
+    Component {
+        id: column
+
+        ColumnLayout {
+            spacing: 0
+            Repeater {
+                model: node.widget.children || []
+                Child {
+                    vertical: true
+                }
+            }
+        }
+    }
+
+    Component {
+        id: row
+
+        RowLayout {
+            spacing: 0
+            Repeater {
+                model: node.widget.children || []
+                Child {
+                    vertical: false
+                }
+            }
+        }
+    }
+
+    Component {
+        id: textView
+
+        Controls.Label {
+            id: label
+            property bool expanded: false
+            // R9 7.7.4.14.6 viewAll: the first lines, and all of it on a tap
+            readonly property int viewAll: parseInt(node.widget.viewAll) || 0
+            text: node.widget.text || ""
+            wrapMode: Text.Wrap
+            maximumLineCount: viewAll > 0 && !expanded ? viewAll : undefined
+            elide: viewAll > 0 && !expanded ? Text.ElideRight : Text.ElideNone
+            color: node.colour(node.widget.textColor, node.textColor)
+            font.pixelSize: node.dp(node.widget.textSize, Kirigami.Theme.defaultFont.pixelSize > 0 ? Kirigami.Theme.defaultFont.pixelSize : 14)
+            font.weight: String(node.widget.textStyle || "").indexOf("bold") >= 0 ? Font.Bold : Font.Normal
+            font.italic: String(node.widget.textStyle || "").indexOf("italic") >= 0
+            horizontalAlignment: {
+                const a = String(node.widget.textAlignment || node.widget.gravity || "")
+                return a.indexOf("center") >= 0 ? Text.AlignHCenter
+                     : (a.indexOf("textEnd") >= 0 || a.indexOf("viewEnd") >= 0 || a.indexOf("end") >= 0 || a.indexOf("right") >= 0) ? Text.AlignRight
+                     : Text.AlignLeft
+            }
+            MouseArea {
+                anchors.fill: parent
+                enabled: label.viewAll > 0 && (label.truncated || label.expanded) && !node.widget.click
+                onClicked: label.expanded = !label.expanded
+            }
+        }
+    }
+
+    Component {
+        id: button
+
+        Controls.AbstractButton {
+            id: control
+            text: node.widget.text || ""
+            implicitWidth: buttonLabel.implicitWidth + Kirigami.Units.largeSpacing * 2
+            implicitHeight: buttonLabel.implicitHeight + Kirigami.Units.largeSpacing * 2
+            Accessible.name: text
+            contentItem: Controls.Label {
+                id: buttonLabel
+                text: control.text
+                horizontalAlignment: Text.AlignHCenter
+                verticalAlignment: Text.AlignVCenter
+                wrapMode: Text.Wrap
+                color: node.colour(node.widget.textColor, Kirigami.Theme.highlightColor)
+                font.pixelSize: node.dp(node.widget.textSize, Kirigami.Theme.defaultFont.pixelSize > 0 ? Kirigami.Theme.defaultFont.pixelSize : 14)
+                font.weight: String(node.widget.textStyle || "").indexOf("bold") >= 0 ? Font.Bold : Font.Normal
+            }
+            background: Rectangle {
+                radius: frame.radius
+                color: control.down ? Kirigami.ColorUtils.tintWithAlpha(frame.color, Kirigami.Theme.highlightColor, 0.3) : "transparent"
+                border.width: node.widget.background ? 0 : 1
+                border.color: Kirigami.ColorUtils.tintWithAlpha(Kirigami.Theme.backgroundColor, Kirigami.Theme.highlightColor, 0.6)
+            }
+            onClicked: if (node.widget.click) node.suggestionTriggered(node.widget.click)
+        }
+    }
+
+    Component {
+        id: imageView
+
+        RichImage {
+            id: picture
+            url: node.widget.image || ""
+            folder: node.folder
+            playable: !!node.widget.playable
+            fixedHeight: isNaN(node.fixedHeight) ? -1 : node.fixedHeight
+            fillMode: {
+                switch (node.widget.scaleType) {
+                case "fitXY":
+                    return Image.Stretch
+                case "fitCenter":
+                case "fitStart":
+                case "fitEnd":
+                case "centerInside":
+                    return Image.PreserveAspectFit
+                case "center":
+                case "matrix":
+                    return Image.Pad
+                default:
+                    return Image.PreserveAspectCrop
+                }
+            }
+            // R9 7.7.4.14.5: the click's action, or the picture itself
+            onClicked: node.widget.click ? node.suggestionTriggered(node.widget.click) : node.imageClicked(picture.localUrl, node.widget)
+        }
+    }
+}
diff --git a/src/contents/ui/RichCard.qml b/src/contents/ui/RichCard.qml
new file mode 100644
index 0000000..26346c7
--- /dev/null
+++ b/src/contents/ui/RichCard.qml
@@ -0,0 +1,141 @@
+// SPDX-FileCopyrightText: 2026 Noa Himesaka <himesaka@noa.codes>
+//
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as Controls
+
+import org.kde.kirigami as Kirigami
+
+// One RCS rich card (RCC.07 3.6.10.5): media, title, description and the
+// card's own suggestions, vertical or horizontal.
+Rectangle {
+    id: card
+
+    // {title, description, media, suggestions} from RichMessage::parse()
+    property var cardData: ({})
+    // the message: orientation, imageAlignment, font styles
+    property var rich: ({})
+    property bool horizontal: false
+    property string folder
+    property color textColor: Kirigami.Theme.textColor
+    property real pointSize: Kirigami.Theme.defaultFont.pointSize
+
+    signal suggestionTriggered(var suggestion)
+    signal mediaClicked(var media, string localUrl)
+    signal pressAndHold()
+
+    readonly property var media: cardData.media || ({})
+    readonly property bool hasMedia: !!media.image || !!media.playable
+    // SHORT/MEDIUM/TALL_HEIGHT as 112/168/264 logical pixels: RCC.07 names the
+    // heights but gives no sizes; these are the usual RBM dp values (chosen)
+    readonly property real mediaHeight: media.height === "SHORT_HEIGHT" ? 112 : media.height === "TALL_HEIGHT" ? 264 : 168
+
+    function styles(list) {
+        return {
+            bold: !!list && list.indexOf("bold") >= 0,
+            italic: !!list && list.indexOf("italics") >= 0,
+            underline: !!list && list.indexOf("underline") >= 0
+        }
+    }
+    readonly property var titleStyle: styles(rich.titleFontStyle)
+    readonly property var descriptionStyle: styles(rich.descriptionFontStyle)
+
+    implicitHeight: layout.implicitHeight
+    radius: Kirigami.Units.gridUnit / 2
+    border.width: 1
+    border.color: Kirigami.ColorUtils.tintWithAlpha(color, Kirigami.Theme.textColor, 0.15)
+    clip: true
+
+    GridLayout {
+        id: layout
+        width: parent.width
+        columns: card.horizontal ? 2 : 1
+        columnSpacing: 0
+        rowSpacing: 0
+        layoutDirection: card.horizontal && card.rich.imageAlignment === "RIGHT" ? Qt.RightToLeft : Qt.LeftToRight
+
+        RichImage {
+            id: image
+            visible: card.hasMedia
+            Layout.preferredWidth: card.horizontal ? Math.round(card.width * 0.4) : card.width
+            Layout.fillHeight: card.horizontal
+            Layout.alignment: Qt.AlignTop
+            fixedHeight: card.horizontal ? Math.max(text.implicitHeight, 112) : card.mediaHeight
+            url: card.media.image || ""
+            folder: card.folder
+            playable: !!card.media.playable
+            contentDescription: card.media.contentDescription || ""
+            onClicked: card.mediaClicked(card.media, image.localUrl)
+            onPressAndHold: card.pressAndHold()
+        }
+
+        ColumnLayout {
+            id: text
+            Layout.fillWidth: true
+            Layout.alignment: Qt.AlignTop
+            Layout.margins: Kirigami.Units.largeSpacing
+            spacing: Kirigami.Units.smallSpacing
+
+            Controls.Label {
+                visible: !!card.cardData.title
+                Layout.fillWidth: true
+                text: card.cardData.title || ""
+                wrapMode: Text.Wrap
+                maximumLineCount: 3
+                elide: Text.ElideRight
+                color: card.textColor
+                font.pointSize: card.pointSize
+                font.weight: Font.Bold
+                font.italic: card.titleStyle.italic
+                font.underline: card.titleStyle.underline
+            }
+            Controls.Label {
+                visible: !!card.cardData.description
+                Layout.fillWidth: true
+                text: card.cardData.description || ""
+                wrapMode: Text.Wrap
+                maximumLineCount: 12
+                elide: Text.ElideRight
+                color: card.textColor
+                font.pointSize: card.pointSize - 1
+                font.weight: card.descriptionStyle.bold ? Font.Bold : Font.Normal
+                font.italic: card.descriptionStyle.italic
+                font.underline: card.descriptionStyle.underline
+            }
+        }
+
+        // the card's suggestions: buttons along its bottom
+        ColumnLayout {
+            visible: (card.cardData.suggestions || []).length > 0
+            Layout.columnSpan: layout.columns
+            Layout.fillWidth: true
+            spacing: 0
+
+            Repeater {
+                model: card.cardData.suggestions || []
+
+                ColumnLayout {
+                    Layout.fillWidth: true
+                    spacing: 0
+                    required property var modelData
+
+                    Rectangle {
+                        Layout.fillWidth: true
+                        implicitHeight: 1
+                        color: card.border.color
+                    }
+                    RichSuggestion {
+                        Layout.fillWidth: true
+                        chip: false
+                        suggestion: parent.modelData
+                        onTriggered: suggestion => card.suggestionTriggered(suggestion)
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/src/contents/ui/RichImage.qml b/src/contents/ui/RichImage.qml
new file mode 100644
index 0000000..c279925
--- /dev/null
+++ b/src/contents/ui/RichImage.qml
@@ -0,0 +1,105 @@
+// SPDX-FileCopyrightText: 2026 Noa Himesaka <himesaka@noa.codes>
+//
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+
+import org.kde.kirigami as Kirigami
+
+import org.kde.spacebar
+
+// A picture of an RCS chatbot message (http/https), fetched once into the
+// conversation's attachment folder. Decoded for the screen's pixels and
+// shown at the logical size, as the attachment images are.
+Item {
+    id: root
+
+    property string url
+    property string folder
+    // when it is set, the picture fills this height; otherwise its own
+    // aspect ratio decides at the given width
+    property real fixedHeight: -1
+    property int fillMode: Image.PreserveAspectCrop
+    property bool playable: false
+    property string contentDescription
+    readonly property alias status: image.status
+    property string localUrl: ""
+
+    signal clicked()
+    signal pressAndHold()
+
+    implicitHeight: fixedHeight >= 0 ? fixedHeight
+                  : image.implicitWidth > 0 ? Math.round(image.implicitHeight * width / image.implicitWidth)
+                  : Kirigami.Units.gridUnit * 6
+
+    function refresh() {
+        localUrl = url ? RichMedia.localFile(url, folder) : ""
+    }
+    onUrlChanged: refresh()
+    onFolderChanged: refresh()
+    Component.onCompleted: refresh()
+
+    Connections {
+        target: RichMedia
+        function onFetched(fetchedUrl, local) {
+            if (fetchedUrl === root.url) {
+                root.localUrl = local
+            }
+        }
+    }
+
+    Rectangle {
+        anchors.fill: parent
+        visible: image.status !== Image.Ready
+        color: Kirigami.ColorUtils.tintWithAlpha(Kirigami.Theme.backgroundColor, Kirigami.Theme.textColor, 0.08)
+
+        Kirigami.Icon {
+            anchors.centerIn: parent
+            width: Kirigami.Units.iconSizes.medium
+            height: width
+            source: "image-x-generic"
+            color: Kirigami.Theme.disabledTextColor
+            visible: !root.playable
+        }
+    }
+
+    Image {
+        id: image
+        anchors.fill: parent
+        // not before the width is known: it decides the decoded size
+        source: root.width > 0 ? root.localUrl : ""
+        fillMode: root.fillMode
+        asynchronous: true
+        cache: false
+        // Qt scales sourceSize by the device pixel ratio only for SVG/PDF
+        sourceSize: Qt.size(Math.round(root.width * Screen.devicePixelRatio),
+                            root.fixedHeight >= 0 && root.fillMode === Image.PreserveAspectCrop ? Math.round(root.height * Screen.devicePixelRatio) : 0)
+        Accessible.name: root.contentDescription
+    }
+
+    // video, audio, R9's iframe play: it opens outside
+    Rectangle {
+        visible: root.playable
+        anchors.centerIn: parent
+        width: Kirigami.Units.iconSizes.large
+        height: width
+        radius: width / 2
+        color: Qt.rgba(0, 0, 0, 0.55)
+
+        Kirigami.Icon {
+            anchors.centerIn: parent
+            width: Kirigami.Units.iconSizes.medium
+            height: width
+            source: "media-playback-start"
+            color: "white"
+        }
+    }
+
+    MouseArea {
+        anchors.fill: parent
+        onClicked: root.clicked()
+        onPressAndHold: root.pressAndHold()
+    }
+}
diff --git a/src/contents/ui/RichMessage.qml b/src/contents/ui/RichMessage.qml
new file mode 100644
index 0000000..fb6e22b
--- /dev/null
+++ b/src/contents/ui/RichMessage.qml
@@ -0,0 +1,193 @@
+// SPDX-FileCopyrightText: 2026 Noa Himesaka <himesaka@noa.codes>
+//
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+pragma ComponentBehavior: Bound
+
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls as Controls
+
+import org.kde.kirigami as Kirigami
+
+// An RCS chatbot message (RCC.07 3.6.10, R9 7.7) in the conversation: the
+// header and footer outside the card (R9 7.7.4.3), a rich card, a carousel
+// or an open rich card, and the chip list. What it cannot show (a text, an
+// unknown or broken message) the bubble's text shows: the summary the
+// daemon stored.
+ColumnLayout {
+    id: root
+
+    // RichMessage::parse() of the message
+    property var rich: ({})
+    property string folder
+    // the width a single card takes, and the carousel's
+    property real cardWidth: Kirigami.Units.gridUnit * 16
+    property real carouselWidth: cardWidth
+    property color cardColor: Kirigami.Theme.backgroundColor
+    property color textColor: Kirigami.Theme.textColor
+    property real pointSize: Kirigami.Theme.defaultFont.pointSize
+    // the chip list belongs to the newest message only
+    property bool showChips: true
+
+    signal suggestionTriggered(var suggestion)
+    signal mediaClicked(var media, string localUrl)
+    signal pressAndHold()
+
+    readonly property string kind: rich.kind || ""
+    // shown here, card and all; otherwise the bubble's text is the message
+    readonly property bool rendered: kind === "card" || kind === "carousel" || kind === "openrichcard"
+    readonly property var chips: rich.suggestions || []
+
+    spacing: Kirigami.Units.smallSpacing
+
+    // (광고)[Web발신], with R9 7.7.4.13's verified mark and its text
+    RowLayout {
+        visible: root.rendered && (!!root.rich.header || (root.rich.verified && !!root.rich.headerExtension))
+        Layout.maximumWidth: root.kind === "carousel" ? root.carouselWidth : root.cardWidth
+        spacing: Kirigami.Units.smallSpacing
+
+        Controls.Label {
+            visible: !!root.rich.header
+            text: root.rich.header || ""
+            wrapMode: Text.Wrap
+            Layout.fillWidth: !root.rich.verified
+            font: Kirigami.Theme.smallFont
+            color: Kirigami.Theme.disabledTextColor
+        }
+        Kirigami.Icon {
+            visible: !!root.rich.verified
+            implicitWidth: Kirigami.Units.iconSizes.small
+            implicitHeight: implicitWidth
+            source: "security-high"
+        }
+        Controls.Label {
+            visible: !!root.rich.verified && !!root.rich.headerExtension
+            text: root.rich.headerExtension || ""
+            Layout.fillWidth: true
+            wrapMode: Text.Wrap
+            font: Kirigami.Theme.smallFont
+            color: Kirigami.Theme.positiveTextColor
+        }
+    }
+
+    RichCard {
+        visible: root.kind === "card"
+        Layout.preferredWidth: root.cardWidth
+        color: root.cardColor
+        textColor: root.textColor
+        pointSize: root.pointSize
+        cardData: root.kind === "card" && root.rich.cards.length > 0 ? root.rich.cards[0] : ({})
+        rich: root.rich
+        horizontal: root.rich.orientation === "HORIZONTAL"
+        folder: root.folder
+        onSuggestionTriggered: suggestion => root.suggestionTriggered(suggestion)
+        onMediaClicked: (media, localUrl) => root.mediaClicked(media, localUrl)
+        onPressAndHold: root.pressAndHold()
+    }
+
+    // RCC.07 carousel: cards side by side, swiped through
+    Flickable {
+        id: carousel
+        visible: root.kind === "carousel"
+        Layout.preferredWidth: root.carouselWidth
+        Layout.preferredHeight: cards.implicitHeight
+        contentWidth: cards.implicitWidth
+        contentHeight: cards.implicitHeight
+        flickableDirection: Flickable.HorizontalFlick
+        boundsBehavior: Flickable.StopAtBounds
+        clip: true
+        // RCC.07: SMALL_WIDTH (the default) or MEDIUM_WIDTH
+        readonly property real itemWidth: root.rich.cardWidth === "MEDIUM_WIDTH" ? Kirigami.Units.gridUnit * 13 : Kirigami.Units.gridUnit * 9
+
+        Row {
+            id: cards
+            spacing: Kirigami.Units.largeSpacing
+
+            Repeater {
+                model: root.kind === "carousel" ? root.rich.cards : []
+
+                RichCard {
+                    required property var modelData
+                    width: carousel.itemWidth
+                    height: implicitHeight
+                    color: root.cardColor
+                    textColor: root.textColor
+                    pointSize: root.pointSize
+                    cardData: modelData
+                    rich: root.rich
+                    folder: root.folder
+                    onSuggestionTriggered: suggestion => root.suggestionTriggered(suggestion)
+                    onMediaClicked: (media, localUrl) => root.mediaClicked(media, localUrl)
+                    onPressAndHold: root.pressAndHold()
+                }
+            }
+        }
+    }
+
+    // R9 open rich card: the bot's own layout
+    Rectangle {
+        visible: root.kind === "openrichcard"
+        Layout.preferredWidth: root.cardWidth
+        implicitHeight: openRich.implicitHeight
+        radius: Kirigami.Units.gridUnit / 2
+        color: root.cardColor
+        border.width: 1
+        border.color: Kirigami.ColorUtils.tintWithAlpha(color, Kirigami.Theme.textColor, 0.15)
+        clip: true
+
+        OpenRichNode {
+            id: openRich
+            width: parent.width
+            isRoot: true
+            widget: root.kind === "openrichcard" ? (root.rich.layout || ({})) : ({})
+            folder: root.folder
+            textColor: root.textColor
+            availableWidth: width
+            onSuggestionTriggered: suggestion => root.suggestionTriggered(suggestion)
+            onImageClicked: (localUrl, widget) => root.mediaClicked(widget, localUrl)
+        }
+    }
+
+    // an open rich card's own suggestions
+    Repeater {
+        model: root.kind === "openrichcard" ? (root.rich.cardSuggestions || []) : []
+
+        RichSuggestion {
+            required property var modelData
+            Layout.preferredWidth: root.cardWidth
+            chip: false
+            suggestion: modelData
+            onTriggered: suggestion => root.suggestionTriggered(suggestion)
+        }
+    }
+
+    // 수신거부:080-...
+    Controls.Label {
+        visible: root.rendered && !!root.rich.footer
+        Layout.maximumWidth: root.kind === "carousel" ? root.carouselWidth : root.cardWidth
+        text: root.rich.footer || ""
+        wrapMode: Text.Wrap
+        font: Kirigami.Theme.smallFont
+        color: Kirigami.Theme.disabledTextColor
+    }
+
+    // the chip list (botsuggestion)
+    Flow {
+        visible: root.showChips && root.chips.length > 0
+        // under a card as wide as the carousel; in a text bubble as wide as a card
+        Layout.preferredWidth: root.rendered ? root.carouselWidth : root.cardWidth
+        Layout.topMargin: Kirigami.Units.smallSpacing
+        spacing: Kirigami.Units.smallSpacing
+
+        Repeater {
+            model: root.chips
+
+            RichSuggestion {
+                required property var modelData
+                suggestion: modelData
+                onTriggered: suggestion => root.suggestionTriggered(suggestion)
+            }
+        }
+    }
+}
