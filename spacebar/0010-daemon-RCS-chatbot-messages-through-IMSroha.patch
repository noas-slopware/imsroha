+void ChannelLogger::sendSuggestionResponse(const QString &numbers, const QString &id, const QString &inReplyTo, const QString &suggestion)
+{
+    sendSuggestionResponseTask(PhoneNumberList(numbers), id, inReplyTo, suggestion);
+}
+
+QCoro::Task<void>
+ChannelLogger::sendSuggestionResponseTask(const PhoneNumberList phoneNumberList, const QString id, const QString inReplyTo, const QString suggestion)
+{
+    if (phoneNumberList.size() != 1) {
+        co_return;
+    }
+    const QJsonObject raw = QJsonDocument::fromJson(suggestion.toUtf8()).object();
+    const QString response = RichMessage::responseJson(raw);
+    // RCC.07 3.6.10.6.2.1: a suggested reply shows as a message we sent.
+    const bool shown = RichMessage::isReply(raw) && !id.isEmpty();
+
+    QString inReplyToMessageId;
+    if (!inReplyTo.isEmpty()) {
+        const auto found = co_await m_database.messagesForNumber(PhoneNumberList(), inReplyTo);
+        if (!found.empty()) {
+            inReplyToMessageId = found.front().messageId;
+        }
+    }
+
+    Message message;
+    if (shown) {
+        message.id = id;
+        message.phoneNumberList = phoneNumberList;
+        message.text = RichMessage::displayText(raw);
+        message.datetime = QDateTime::currentDateTime();
+        message.read = true;
+        message.sentByMe = true;
+        message.deliveryStatus = MessageState::Pending;
+        message.transport = SL("rcs");
+        message.richContentType = BOT_RESPONSE_TYPE;
+        message.richBody = response;
+        co_await addMessage(message);
+        updateMessage(message);
+    }
+    if (response.isEmpty()) {
+        // an action without postback data: nothing goes back
+        co_return;
+    }
+
+    const auto rcsId = co_await m_rcs.sendSuggestionResponse(phoneNumberList.first().toE164(), inReplyToMessageId, response);
+    if (!shown) {
+        co_return;
+    }
+    if (rcsId) {
+        co_await m_database.updateMessageSent(id, *rcsId, QString());
+    } else {
+        // never as SMS: the bot would get the label without its postback
+        co_await m_database.updateMessageDeliveryState(id, MessageState::Failed);
+        message.deliveryStatus = MessageState::Failed;
+        updateMessage(message);
+    }
+}
+
+QString ChannelLogger::botInfo(const QString &numbers)
+{
+    const PhoneNumberList phoneNumberList(numbers);
+    if (phoneNumberList.size() != 1) {
+        return {};
+    }
+    const QString botId = QCoro::waitFor(m_database.botIdForNumber(phoneNumberList));
+    if (botId.isEmpty()) {
+        return {};
+    }
+    const auto info = QCoro::waitFor(m_database.botInfo(botId));
+    refreshBotInfo(phoneNumberList.toString(), botId, true);
+    return info ? info->first : QString();
+}
+
+QCoro::Task<void> ChannelLogger::refreshBotInfo(const QString phoneNumber, const QString botId, bool onlyWhenStale)
+{
+    if (m_botInfoPending.contains(botId)) {
+        co_return;
+    }
+    if (onlyWhenStale) {
+        const auto info = co_await m_database.botInfo(botId);
+        if (info && info->second.secsTo(QDateTime::currentDateTime()) < 86400) {
+            co_return;
+        }
+    }
+    m_botInfoPending.insert(botId);
+    // IMSroha keeps it by ETag and Cache-Control; this is for when it is not
+    // there, and for the conversation list.
+    const auto json = co_await m_rcs.botInfo(botId);
+    m_botInfoPending.remove(botId);
+    if (!json || RichMessage::botInfo(*json).isEmpty()) {
+        co_return;
+    }
+    co_await m_database.setBotInfo(botId, *json);
+    m_botNames.insert(botId, RichMessage::botInfo(*json).value(u"name").toString());
+    Q_EMIT botInfoChanged(phoneNumber, *json);
+}
