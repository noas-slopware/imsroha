+QCoro::Task<std::optional<QString>> RcsTransport::sendSuggestionResponse(const QString &number, const QString &inReplyTo, const QString &responseJson)
+{
+    QDBusMessage call = QDBusMessage::createMethodCall(RCS_SERVICE, RCS_PATH, RCS_IFACE, SL("SendSuggestionResponse"));
+    call << number << inReplyTo << responseJson;
+    const QDBusPendingReply<QString> pending = QDBusConnection::systemBus().asyncCall(call);
+    const QDBusPendingReply<QString> reply = co_await pending;
+    if (!reply.isValid()) {
+        qDebug() << "RCS: SendSuggestionResponse to" << number << reply.error().message();
+        co_return std::nullopt;
+    }
+    co_return reply.value();
+}
+
+QCoro::Task<std::optional<QString>> RcsTransport::botInfo(const QString &botId)
+{
+    if (!isRegistered()) {
+        co_return std::nullopt;
+    }
+    QDBusMessage call = QDBusMessage::createMethodCall(RCS_SERVICE, RCS_PATH, RCS_IFACE, SL("GetBotInfo"));
+    call << botId;
+    // an HTTP query on IMSroha's side
+    const QDBusPendingReply<QString> pending = QDBusConnection::systemBus().asyncCall(call, 30000);
+    const QDBusPendingReply<QString> reply = co_await pending;
+    if (!reply.isValid()) {
+        qDebug() << "RCS: chatbot information of" << botId << reply.error().name() << reply.error().message();
+        co_return std::nullopt;
+    }
+    co_return reply.value();
+}
