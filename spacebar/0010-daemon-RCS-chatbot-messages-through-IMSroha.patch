+-- SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+-- RCS chatbot messages through IMSroha: the message as received (content
+-- type and body, the botsuggestion chip list) and the chatbot it came from.
+-- text holds its readable summary. NULL for everything else.
+ALTER TABLE Messages ADD COLUMN richContentType TEXT;
+ALTER TABLE Messages ADD COLUMN richBody TEXT;
+ALTER TABLE Messages ADD COLUMN suggestions TEXT;
+ALTER TABLE Messages ADD COLUMN botId TEXT;
+
+-- Chatbot information (RCC.07 botinfo) by service ID, as IMSroha's
+-- GetBotInfo returned it, updated in milliseconds since the epoch.
+CREATE TABLE BotInfo (botId TEXT PRIMARY KEY NOT NULL, info TEXT NOT NULL, updated INTEGER NOT NULL);
