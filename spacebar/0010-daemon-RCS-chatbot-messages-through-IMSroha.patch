+// SPDX-FileCopyrightText: 2026 Noa Himesaka <himesaka@noa.codes>
+//
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+#pragma once
+
+#include <QJsonObject>
+#include <QString>
+
+/*
+ * RCS chatbot messages (GSMA RCC.07 3.6.10, TTAK.KO-06.0410/R9 7.7) as
+ * IMSroha hands them over, reduced to what the conversation shows.
+ *
+ * parse() takes the content type, the body and the botsuggestion part, and
+ * returns one object for the view:
+ *
+ *   kind          "card", "carousel", "openrichcard", "text" or "unknown"
+ *   header        R9 messageHeader ("(광고)[Web발신]"), shown above the card
+ *   footer        R9 messageFooter ("수신거부:080-..."), shown below it
+ *   verified      R9 7.7.4.13 verifiedIndicator, with headerExtension
+ *   copyAllowed   R9 7.7.4.4
+ *   shareAllowed  R9 7.7.4.15.1, true unless the message says false
+ *   orientation, imageAlignment, cardWidth, titleFontStyle,
+ *   descriptionFontStyle   the RCC.07 card layout
+ *   cards         [{title, description, media, suggestions}]
+ *   layout        the open rich card's widget tree, as received
+ *   text          the text of a text message
+ *   suggestions   the chip list (botsuggestion), normalised
+ *   copyText      what "copy" copies (R9 7.7.4.4)
+ *   fallbackText  the readable text of all of it; never empty
+ *
+ * Every suggestion is {type: "reply"|"action", displayText, hasPostback,
+ * action: "url"|"localBrowser"|"dial"|"map"|"calendar"|"compose"|"device"|
+ * "settings"|"copy"|"share"|"deeplink"|"unknown", the action's parameters,
+ * raw: the suggestion as received}. The raw object is what goes back to
+ * responseJson() when it is tapped.
+ */
+namespace RichMessage
+{
+QJsonObject parse(const QString &contentType, const QString &body, const QString &suggestions);
+
+// The text a received chatbot message is stored and notified with.
+QString summary(const QString &contentType, const QString &body, const QString &suggestions);
+
+// The application/vnd.gsma.botsuggestion.response.v1.0+json body for a
+// tapped suggestion (RCC.07 3.6.10.6.2): a reply with everything it came
+// with, an action with its displayText and postback. Empty for an action
+// without postback: then nothing goes back.
+QString responseJson(const QJsonObject &rawSuggestion);
+
+// The display text of a suggestion ("" when it has none).
+QString displayText(const QJsonObject &rawSuggestion);
+bool isReply(const QJsonObject &rawSuggestion);
+
+/*
+ * Chatbot information (RCC.07 3.6.4.1.3, R9 7.7.2) for the conversation:
+ *   name, icon, description, phoneNumber (R9 subNum or the callback number),
+ *   colour, a2p, inputDisabled (whether the user may not type, R9
+ *   userInputCtrlCd/a2pTypeCd, RCC.07 Disable_User_feedback), serviceId.
+ * R9 does not say where in the JSON its extra fields sit; they are looked
+ * up in botinfo, at the top and next to the PCC.
+ */
+QJsonObject botInfo(const QString &json);
+}
