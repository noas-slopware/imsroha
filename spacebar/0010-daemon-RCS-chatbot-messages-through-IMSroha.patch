+QCoro::Task<QString> Database::botIdForNumber(const PhoneNumberList &phoneNumberList) const
+{
+    const auto id = co_await m_database->getResult<SingleValue<QString>>(
+        SL("SELECT botId FROM Messages WHERE phoneNumber == ? AND botId IS NOT NULL AND botId != '' ORDER BY time DESC LIMIT 1"),
+        phoneNumberList.toString());
+    co_return id ? id->value : QString();
+}
+
+namespace
+{
+struct BotInfoRow {
+    using ColumnTypes = std::tuple<QString, qint64>;
+    static BotInfoRow fromSql(ColumnTypes tuple)
+    {
+        auto [info, updated] = tuple;
+        return BotInfoRow{info, updated};
+    }
+    QString info;
+    qint64 updated;
+};
+}
+
+QCoro::Task<std::optional<std::pair<QString, QDateTime>>> Database::botInfo(const QString &botId) const
+{
+    const auto row = co_await m_database->getResult<BotInfoRow>(SL("SELECT info, updated FROM BotInfo WHERE botId == ?"), botId);
+    if (!row) {
+        co_return std::nullopt;
+    }
+    co_return std::make_pair(row->info, QDateTime::fromMSecsSinceEpoch(row->updated));
+}
+
+QCoro::Task<> Database::setBotInfo(const QString &botId, const QString &info)
+{
+    co_await m_database->execute(SL("INSERT OR REPLACE INTO BotInfo (botId, info, updated) VALUES (?, ?, ?)"),
+                                 botId,
+                                 info,
+                                 QDateTime::currentMSecsSinceEpoch());
+}
