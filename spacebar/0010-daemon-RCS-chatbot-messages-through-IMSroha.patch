+// SPDX-FileCopyrightText: 2026 Noa Himesaka <himesaka@noa.codes>
+//
+// SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
+
+#include "richmessage.h"
+
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QStringList>
+#include <QUrl>
+
+#include <KLocalizedString>
+
+using namespace Qt::StringLiterals;
+
+namespace
+{
+// R9's examples have keys with stray spaces (" clipboardAction"); a bot
+// that copied them is still understood.
+QJsonValue member(const QJsonObject &o, const QString &key)
+{
+    const auto it = o.constFind(key);
+    if (it != o.constEnd()) {
+        return *it;
+    }
+    for (auto i = o.constBegin(); i != o.constEnd(); ++i) {
+        if (i.key().trimmed() == key) {
+            return i.value();
+        }
+    }
+    return QJsonValue(QJsonValue::Undefined);
+}
+
+QJsonObject object(const QJsonObject &o, const QString &key)
+{
+    return member(o, key).toObject();
+}
+
+bool has(const QJsonObject &o, const QString &key)
+{
+    return !member(o, key).isUndefined();
+}
+
+QString text(const QJsonObject &o, const QString &key)
+{
+    const QJsonValue v = member(o, key);
+    if (v.isString()) {
+        return v.toString().trimmed();
+    }
+    if (v.isDouble()) {
+        return QString::number(v.toDouble());
+    }
+    return {};
+}
+
+// "true", true and 1 are all true; absent is the default.
+bool flag(const QJsonObject &o, const QString &key, bool fallback)
+{
+    const QJsonValue v = member(o, key);
+    if (v.isBool()) {
+        return v.toBool();
+    }
+    if (v.isString()) {
+        const QString s = v.toString().trimmed().toLower();
+        if (s == u"true" || s == u"1") {
+            return true;
+        }
+        if (s == u"false" || s == u"0") {
+            return false;
+        }
+    }
+    if (v.isDouble()) {
+        return v.toDouble() != 0;
+    }
+    return fallback;
+}
+
+// The first of these objects that has the key.
+QJsonValue lookup(const QList<QJsonObject> &levels, const QString &key)
+{
+    for (const auto &o : levels) {
+        const QJsonValue v = member(o, key);
+        if (!v.isUndefined() && !v.isNull()) {
+            return v;
+        }
+    }
+    return {};
+}
+
+// Only web addresses are fetched or opened from a card's media.
+bool isWebUrl(const QString &url)
+{
+    const QUrl u(url);
+    return u.isValid() && (u.scheme() == u"https" || u.scheme() == u"http") && !u.host().isEmpty();
+}
+
+QJsonObject suggestion(const QJsonObject &raw)
+{
+    QJsonObject out{{u"raw"_s, raw}};
+    if (has(raw, u"reply"_s)) {
+        const QJsonObject reply = object(raw, u"reply"_s);
+        out[u"type"_s] = u"reply"_s;
+        out[u"action"_s] = u"reply"_s;
+        out[u"displayText"_s] = text(reply, u"displayText"_s);
+        out[u"hasPostback"_s] = has(reply, u"postback"_s);
+        return out;
+    }
+
+    const QJsonObject a = object(raw, u"action"_s);
+    out[u"type"_s] = u"action"_s;
+    out[u"displayText"_s] = text(a, u"displayText"_s);
+    out[u"hasPostback"_s] = has(a, u"postback"_s);
+
+    QString kind = u"unknown"_s;
+    if (has(a, u"urlAction"_s)) {
+        const QJsonObject open = object(object(a, u"urlAction"_s), u"openUrl"_s);
+        kind = u"url"_s;
+        out[u"url"_s] = text(open, u"url"_s);
+        out[u"application"_s] = text(open, u"application"_s);
+    } else if (has(a, u"localBrowserAction"_s)) {
+        // R9 7.7.4.8: an in-app browser that posts parameters and reports a
+        // result. Spacebar has none: the page opens in the browser.
+        const QJsonObject open = object(object(a, u"localBrowserAction"_s), u"openUrl"_s);
+        kind = u"localBrowser"_s;
+        out[u"url"_s] = text(open, u"url"_s);
+    } else if (has(a, u"dialerAction"_s)) {
+        const QJsonObject dialer = object(a, u"dialerAction"_s);
+        kind = u"dial"_s;
+        for (const auto &variant : {u"dialPhoneNumber"_s, u"dialEnrichedCall"_s, u"dialVideoCall"_s}) {
+            if (has(dialer, variant)) {
+                const QJsonObject d = object(dialer, variant);
+                out[u"phoneNumber"_s] = text(d, u"phoneNumber"_s);
+                out[u"fallbackUrl"_s] = text(d, u"fallbackUrl"_s);
+                out[u"video"_s] = variant == u"dialVideoCall";
+                break;
+            }
+        }
+    } else if (has(a, u"mapAction"_s)) {
+        const QJsonObject map = object(a, u"mapAction"_s);
+        if (has(map, u"showLocation"_s)) {
+            const QJsonObject show = object(map, u"showLocation"_s);
+            const QJsonObject location = object(show, u"location"_s);
+            kind = u"map"_s;
+            if (member(location, u"latitude"_s).isDouble() && member(location, u"longitude"_s).isDouble()) {
+                out[u"latitude"_s] = member(location, u"latitude"_s).toDouble();
+                out[u"longitude"_s] = member(location, u"longitude"_s).toDouble();
+            }
+            out[u"label"_s] = text(location, u"label"_s);
+            out[u"query"_s] = text(location, u"query"_s);
+            out[u"fallbackUrl"_s] = text(show, u"fallbackUrl"_s);
+        } else {
+            // requestLocationPush, also R9 7.7.4.9's currentLocation
+            kind = u"locationPush"_s;
+        }
+    } else if (has(a, u"calendarAction"_s)) {
+        const QJsonObject event = object(object(a, u"calendarAction"_s), u"createCalendarEvent"_s);
+        kind = u"calendar"_s;
+        out[u"startTime"_s] = text(event, u"startTime"_s);
+        out[u"endTime"_s] = text(event, u"endTime"_s);
+        out[u"title"_s] = text(event, u"title"_s);
+        out[u"description"_s] = text(event, u"description"_s);
+        out[u"fallbackUrl"_s] = text(event, u"fallbackUrl"_s);
+    } else if (has(a, u"composeAction"_s)) {
+        const QJsonObject compose = object(a, u"composeAction"_s);
+        if (has(compose, u"composeTextMessage"_s)) {
+            const QJsonObject c = object(compose, u"composeTextMessage"_s);
+            kind = u"compose"_s;
+            out[u"phoneNumber"_s] = text(c, u"phoneNumber"_s);
+            out[u"text"_s] = text(c, u"text"_s);
+        } else {
+            const QJsonObject c = object(compose, u"composeRecordingMessage"_s);
+            kind = u"composeRecording"_s;
+            out[u"phoneNumber"_s] = text(c, u"phoneNumber"_s);
+        }
+    } else if (has(a, u"deviceAction"_s)) {
+        kind = u"device"_s;
+    } else if (has(a, u"settingsAction"_s)) {
+        kind = u"settings"_s;
+    } else if (has(a, u"copyAction"_s)) {
+        // RCC.07
+        kind = u"copy"_s;
+        out[u"text"_s] = text(object(object(a, u"copyAction"_s), u"copyText"_s), u"text"_s);
+    } else if (has(a, u"clipboardAction"_s)) {
+        // R9 7.7.4.6
+        kind = u"copy"_s;
+        out[u"text"_s] = text(object(object(a, u"clipboardAction"_s), u"copyToClipboard"_s), u"text"_s);
+    } else if (has(a, u"shareAction"_s)) {
+        // R9 7.7.4.7
+        kind = u"share"_s;
+        out[u"text"_s] = text(object(object(a, u"shareAction"_s), u"shareText"_s), u"text"_s);
+    } else if (has(a, u"deeplinkAction"_s)) {
+        // R9 7.7.4.10
+        kind = u"deeplink"_s;
+        out[u"url"_s] = text(object(a, u"deeplinkAction"_s), u"deeplink"_s);
+    }
+    out[u"action"_s] = kind;
+    return out;
+}
+
+QJsonArray suggestionList(const QJsonValue &value)
+{
+    QJsonArray out;
+    const QJsonArray items = value.toArray();
+    for (const auto &item : items) {
+        const QJsonObject s = item.toObject();
+        if (has(s, u"reply"_s) || has(s, u"action"_s)) {
+            out.append(suggestion(s));
+        }
+    }
+    return out;
+}
+
+QJsonObject media(const QJsonObject &m)
+{
+    if (m.isEmpty()) {
+        return {};
+    }
+    const QString url = text(m, u"mediaUrl"_s);
+    const QString type = text(m, u"mediaContentType"_s).toLower();
+    const QString thumbnail = text(m, u"thumbnailUrl"_s);
+    const qint64 size = member(m, u"mediaFileSize"_s).toInteger();
+    QJsonObject out{
+        {u"mediaUrl"_s, url},
+        {u"mediaContentType"_s, type},
+        {u"thumbnailUrl"_s, thumbnail},
+        {u"height"_s, text(m, u"height"_s)},
+        {u"contentDescription"_s, text(m, u"contentDescription"_s)},
+    };
+    // What is shown: a picture itself (up to 5 MB; a larger one by its
+    // thumbnail), anything else by its thumbnail. Video, audio and R9's
+    // iframe play open the media outside.
+    const bool image = type.startsWith(u"image/");
+    QString shown;
+    if (image && isWebUrl(url) && (size <= 5 * 1024 * 1024 || !isWebUrl(thumbnail))) {
+        shown = url;
+    } else if (isWebUrl(thumbnail)) {
+        shown = thumbnail;
+    }
+    out[u"image"_s] = shown;
+    out[u"playable"_s] = !image && isWebUrl(url);
+    if (has(m, u"click"_s)) {
+        out[u"click"_s] = suggestion(object(m, u"click"_s));
+    }
+    return out;
+}
+
+QJsonObject card(const QJsonObject &content)
+{
+    return {
+        {u"title"_s, text(content, u"title"_s)},
+        {u"description"_s, text(content, u"description"_s)},
+        {u"media"_s, media(object(content, u"media"_s))},
+        {u"suggestions"_s, suggestionList(member(content, u"suggestions"_s))},
+    };
+}
+
+// An open rich card's widget tree with every click normalised, and its
+// text the way R9 7.7.4.4 copies it: TextViews joined by a space, the
+// children of a vertical LinearLayout by a newline.
+QJsonObject openRichNode(const QJsonObject &node, QString *textOut)
+{
+    QJsonObject out = node;
+    const QString widget = text(node, u"widget"_s);
+    const bool gone = text(node, u"visibility"_s) == u"gone";
+    if (has(node, u"click"_s)) {
+        out[u"click"_s] = suggestion(object(node, u"click"_s));
+    }
+    if (widget == u"ImageView") {
+        out[u"image"_s] = media(node).value(u"image"_s);
+        out[u"playable"_s] = media(node).value(u"playable"_s);
+    }
+    if (widget == u"TextView" || widget == u"Button") {
+        if (!gone) {
+            *textOut = text(node, u"text"_s);
+        }
+        return out;
+    }
+    if (widget == u"LinearLayout") {
+        const bool vertical = text(node, u"orientation"_s) != u"horizontal";
+        QJsonArray children;
+        QStringList parts;
+        const QJsonArray items = member(node, u"children"_s).toArray();
+        for (const auto &child : items) {
+            QString childText;
+            children.append(openRichNode(child.toObject(), &childText));
+            if (!childText.isEmpty()) {
+                parts.append(childText);
+            }
+        }
+        out[u"children"_s] = children;
+        if (!gone) {
+            *textOut = parts.join(vertical ? u"\n"_s : u" "_s);
+        }
+    }
+    return out;
+}
+
+// For a message nobody here understands: its text fields, an object's own
+// before those of what it contains, and the suggestions' labels last.
+void collectTexts(const QJsonValue &value, const QStringList &keys, QStringList *texts, int depth = 0)
+{
+    if (depth > 32) {
+        return;
+    }
+    if (value.isObject()) {
+        const QJsonObject o = value.toObject();
+        for (const auto &key : keys) {
+            const QString s = text(o, key);
+            if (!s.isEmpty() && !texts->contains(s)) {
+                texts->append(s);
+            }
+        }
+        for (auto it = o.constBegin(); it != o.constEnd(); ++it) {
+            if (it->isObject() || it->isArray()) {
+                collectTexts(*it, keys, texts, depth + 1);
+            }
+        }
+    } else if (value.isArray()) {
+        const QJsonArray a = value.toArray();
+        for (const auto &v : a) {
+            collectTexts(v, keys, texts, depth + 1);
+        }
+    }
+}
+
+QString findString(const QJsonValue &value, const QString &key, int depth = 0)
+{
+    if (depth > 32) {
+        return {};
+    }
+    if (value.isObject()) {
+        const QJsonObject o = value.toObject();
+        const QString direct = text(o, key);
+        if (!direct.isEmpty()) {
+            return direct;
+        }
+        for (auto it = o.constBegin(); it != o.constEnd(); ++it) {
+            const QString found = findString(*it, key, depth + 1);
+            if (!found.isEmpty()) {
+                return found;
+            }
+        }
+    } else if (value.isArray()) {
+        const QJsonArray a = value.toArray();
+        for (const auto &v : a) {
+            const QString found = findString(v, key, depth + 1);
+            if (!found.isEmpty()) {
+                return found;
+            }
+        }
+    }
+    return {};
+}
+
+QString cardText(const QJsonObject &c)
+{
+    QStringList parts;
+    for (const auto &key : {u"title"_s, u"description"_s}) {
+        const QString s = c.value(key).toString();
+        if (!s.isEmpty()) {
+            parts.append(s);
+        }
+    }
+    return parts.join(u'\n');
+}
+}
+
+namespace RichMessage
+{
+QJsonObject parse(const QString &contentType, const QString &body, const QString &suggestions)
+{
+    QJsonObject out{{u"kind"_s, u"unknown"_s}, {u"shareAllowed"_s, true}, {u"copyAllowed"_s, false}};
+    QJsonParseError error;
+    const QJsonDocument suggestionDoc = QJsonDocument::fromJson(suggestions.toUtf8(), &error);
+    out[u"suggestions"_s] = suggestionList(member(suggestionDoc.object(), u"suggestions"_s));
+
+    const QString type = contentType.trimmed().toLower();
+    QJsonObject root;
+    if (type.startsWith(u"text/")) {
+        out[u"kind"_s] = u"text"_s;
+        out[u"text"_s] = body.trimmed();
+    } else {
+        const QJsonDocument doc = QJsonDocument::fromJson(body.toUtf8(), &error);
+        root = doc.object();
+    }
+
+    // The wire form is RCC.07's {"message": ...}; R9's examples wrap it as
+    // FNW.11 does, {"RCSMessage": {"richcardMessage": {"message": ...}}},
+    // and show open rich cards bare. All of them are taken.
+    QJsonObject level = root;
+    QList<QJsonObject> levels;
+    if (has(level, u"RCSMessage"_s)) {
+        level = object(level, u"RCSMessage"_s);
+    }
+    levels.prepend(level);
+    if (has(level, u"richcardMessage"_s)) {
+        level = object(level, u"richcardMessage"_s);
+        levels.prepend(level);
+    }
+    QJsonObject container; // the object that carries header, footer, copyAllowed...
+    if (has(level, u"openrichcardMessage"_s)) {
+        container = object(level, u"openrichcardMessage"_s);
+        out[u"kind"_s] = u"openrichcard"_s;
+    } else {
+        const QJsonObject message = has(level, u"message"_s) ? object(level, u"message"_s) : level;
+        if (has(message, u"generalPurposeCard"_s)) {
+            container = object(message, u"generalPurposeCard"_s);
+            out[u"kind"_s] = u"card"_s;
+        } else if (has(message, u"generalPurposeCardCarousel"_s)) {
+            container = object(message, u"generalPurposeCardCarousel"_s);
+            out[u"kind"_s] = u"carousel"_s;
+        } else if (text(level, u"card"_s) == u"open_rich_card" || object(level, u"layout"_s).contains(u"widget"_s)) {
+            container = level;
+            out[u"kind"_s] = u"openrichcard"_s;
+        } else if (member(level, u"textMessage"_s).isString()) {
+            out[u"kind"_s] = u"text"_s;
+            out[u"text"_s] = text(level, u"textMessage"_s);
+        }
+    }
+    levels.prepend(container);
+
+    const QString kind = out[u"kind"_s].toString();
+    out[u"header"_s] = lookup(levels, u"messageHeader"_s).toString().trimmed();
+    out[u"footer"_s] = lookup(levels, u"messageFooter"_s).toString().trimmed();
+    out[u"copyAllowed"_s] = flag(container, u"copyAllowed"_s, false);
+    out[u"shareAllowed"_s] = flag(container, u"shareAllowed"_s, true);
+    // R9 7.7.4.13, on RCSMessage; IMSroha may also put the CPIM headers' values there.
+    out[u"verified"_s] = lookup(levels, u"verifiedIndicator"_s).toVariant().toString() == u"1";
+    out[u"headerExtension"_s] = lookup(levels, u"messageHeaderExtension"_s).toString().trimmed();
+
+    QJsonArray cards;
+    QStringList copy;
+    if (kind == u"card" || kind == u"carousel") {
+        const QJsonObject layout = object(container, u"layout"_s);
+        out[u"orientation"_s] = text(layout, u"cardOrientation"_s).toUpper();
+        out[u"imageAlignment"_s] = text(layout, u"imageAlignment"_s).toUpper();
+        out[u"cardWidth"_s] = text(layout, u"cardWidth"_s).toUpper();
+        out[u"titleFontStyle"_s] = member(layout, u"titleFontStyle"_s).toArray();
+        out[u"descriptionFontStyle"_s] = member(layout, u"descriptionFontStyle"_s).toArray();
+        const QJsonValue content = member(container, u"content"_s);
+        const QJsonArray items = kind == u"card" ? QJsonArray{content} : content.toArray();
+        for (const auto &item : items) {
+            const QJsonObject c = card(item.toObject());
+            cards.append(c);
+            const QString t = cardText(c);
+            if (!t.isEmpty()) {
+                copy.append(t);
+            }
+        }
+        if (cards.isEmpty()) {
+            out[u"kind"_s] = u"unknown"_s;
+        }
+    } else if (kind == u"openrichcard") {
+        QString layoutText;
+        out[u"layout"_s] = openRichNode(object(container, u"layout"_s), &layoutText);
+        out[u"cardSuggestions"_s] = suggestionList(member(container, u"suggestions"_s));
+        if (!layoutText.isEmpty()) {
+            copy.append(layoutText);
+        }
+    } else if (kind == u"text") {
+        if (!out[u"text"_s].toString().isEmpty()) {
+            copy.append(out[u"text"_s].toString());
+        }
+    }
+    out[u"cards"_s] = cards;
+    out[u"copyText"_s] = copy.join(u"\n\n"_s);
+
+    // The text it is stored, listed, notified and copied with, and what is
+    // shown when nothing else can be.
+    QStringList lines;
+    QString header = out[u"header"_s].toString();
+    if (out[u"verified"_s].toBool() && !out[u"headerExtension"_s].toString().isEmpty()) {
+        header = (header.isEmpty() ? QString() : header + u' ') + out[u"headerExtension"_s].toString();
+    }
+    if (!header.isEmpty()) {
+        lines.append(header);
+    }
+    QString main = out[u"copyText"_s].toString();
+    if (out[u"kind"_s].toString() == u"unknown") {
+        QStringList texts;
+        collectTexts(root, {u"title"_s, u"description"_s, u"text"_s, u"textMessage"_s}, &texts);
+        collectTexts(root, {u"displayText"_s}, &texts);
+        texts.removeAll(out[u"header"_s].toString());
+        texts.removeAll(out[u"footer"_s].toString());
+        main = i18nc("@info a chatbot message Spacebar cannot show", "Unsupported message");
+        if (!texts.isEmpty()) {
+            main += u'\n' + texts.join(u'\n');
+        }
+    }
+    if (main.isEmpty()) {
+        // a card that is only a picture
+        main = findString(root, u"contentDescription"_s);
+    }
+    if (!main.isEmpty()) {
+        lines.append(main);
+    }
+    if (!out[u"footer"_s].toString().isEmpty()) {
+        lines.append(out[u"footer"_s].toString());
+    }
+    if (lines.isEmpty()) {
+        QStringList labels;
+        const QJsonArray chips = out[u"suggestions"_s].toArray();
+        for (const auto &chip : chips) {
+            const QString label = chip.toObject().value(u"displayText"_s).toString();
+            if (!label.isEmpty()) {
+                labels.append(label);
+            }
+        }
+        lines.append(labels.isEmpty() ? i18nc("@info a chatbot message without any text", "Chatbot message") : labels.join(u" · "_s));
+    }
+    out[u"fallbackText"_s] = lines.join(u'\n');
+    return out;
+}
+
+QString summary(const QString &contentType, const QString &body, const QString &suggestions)
+{
+    return parse(contentType, body, suggestions).value(u"fallbackText"_s).toString();
+}
+
+bool isReply(const QJsonObject &rawSuggestion)
+{
+    return has(rawSuggestion, u"reply"_s);
+}
+
+QString displayText(const QJsonObject &rawSuggestion)
+{
+    return text(object(rawSuggestion, isReply(rawSuggestion) ? u"reply"_s : u"action"_s), u"displayText"_s);
+}
+
+QString responseJson(const QJsonObject &rawSuggestion)
+{
+    QJsonObject response;
+    if (isReply(rawSuggestion)) {
+        // "a reply object including all properties that were provided"
+        response[u"reply"_s] = object(rawSuggestion, u"reply"_s);
+    } else if (has(rawSuggestion, u"action"_s)) {
+        const QJsonObject action = object(rawSuggestion, u"action"_s);
+        if (!has(action, u"postback"_s)) {
+            return {};
+        }
+        response[u"action"_s] = QJsonObject{
+            {u"displayText"_s, member(action, u"displayText"_s)},
+            {u"postback"_s, member(action, u"postback"_s)},
+        };
+    } else {
+        return {};
+    }
+    return QString::fromUtf8(QJsonDocument(QJsonObject{{u"response"_s, response}}).toJson(QJsonDocument::Compact));
+}
+
+QJsonObject botInfo(const QString &json)
+{
+    const QJsonObject root = QJsonDocument::fromJson(json.toUtf8()).object();
+    if (root.isEmpty()) {
+        return {};
+    }
+    const QJsonObject info = object(root, u"botinfo"_s);
+    const QJsonObject pcc = object(info, u"pcc"_s);
+    const QJsonObject details = object(pcc, u"org-details"_s);
+    const QList<QJsonObject> levels{info, root, pcc, details};
+    auto value = [&levels](const QString &key) {
+        const QJsonValue v = lookup(levels, key);
+        return v.isString() ? v.toString().trimmed() : v.isDouble() ? QString::number(v.toInt()) : QString();
+    };
+    // RCC.07 has these as arrays in its example and as objects in places.
+    auto entries = [](const QJsonValue &v) {
+        return v.isArray() ? v.toArray() : v.isObject() ? QJsonArray{v} : QJsonArray{};
+    };
+
+    QJsonObject out;
+    QString name = value(u"subTitle"_s); // R9: the conversation's title
+    if (name.isEmpty()) {
+        const QJsonArray names = entries(member(details, u"org-name"_s));
+        for (const auto &n : names) {
+            const QString display = text(n.toObject(), u"display-name"_s);
+            if (!display.isEmpty() && (name.isEmpty() || text(n.toObject(), u"org-name-type"_s) == u"OfficialName")) {
+                name = display;
+            }
+        }
+    }
+    out[u"name"_s] = name;
+
+    QString icon = value(u"subImage"_s);
+    if (icon.isEmpty()) {
+        const QJsonArray media = entries(member(object(details, u"media-list"_s), u"media-entry"_s));
+        for (const auto &m : media) {
+            const QJsonObject entry = m.toObject();
+            if (text(entry, u"label"_s).compare(u"icon"_s, Qt::CaseInsensitive) == 0) {
+                icon = text(object(entry, u"media"_s), u"media-url"_s);
+                break;
+            }
+        }
+    }
+    out[u"icon"_s] = isWebUrl(icon) ? icon : QString();
+
+    QString description = value(u"subDescription"_s);
+    if (description.isEmpty()) {
+        description = value(u"org-description"_s);
+    }
+    out[u"description"_s] = description;
+
+    const QJsonObject commAddr = object(details, u"comm-addr"_s);
+    QString phone = value(u"subNum"_s);
+    if (phone.isEmpty()) {
+        const QJsonArray tels = entries(member(commAddr, u"tel"_s));
+        for (const auto &t : tels) {
+            phone = text(object(t.toObject(), u"tel-nb"_s), u"tel-str"_s);
+            if (!phone.isEmpty()) {
+                break;
+            }
+        }
+    }
+    out[u"phoneNumber"_s] = phone;
+    const QJsonArray uris = entries(member(commAddr, u"uri-entry"_s));
+    for (const auto &u : uris) {
+        if (text(u.toObject(), u"label"_s).compare(u"ServiceID"_s, Qt::CaseInsensitive) == 0) {
+            out[u"serviceId"_s] = text(u.toObject(), u"addr-uri"_s);
+        }
+    }
+
+    // RCC.07: "base64 url encoded hexadecimal RGB colour representation"
+    const QByteArray colour = QByteArray::fromBase64(value(u"colour"_s).toLatin1(), QByteArray::Base64UrlEncoding);
+    if (colour.size() == 7 && colour.startsWith('#')) {
+        out[u"colour"_s] = QString::fromLatin1(colour);
+    }
+
+    // Whether the user may type here. R9: userInputCtrlCd '0' no, '1' yes,
+    // anything else the app decides; an ordinary A2P sender (bot-a2p-cd 0)
+    // is one-way unless a2pTypeCd says '1'. RCC.07: Disable_User_feedback.
+    const bool a2p = value(u"bot-a2p-cd"_s) == u"0";
+    out[u"a2p"_s] = a2p;
+    const QString control = value(u"userInputCtrlCd"_s);
+    bool disabled;
+    if (control == u"0") {
+        disabled = true;
+    } else if (control == u"1") {
+        disabled = false;
+    } else if (flag(info, u"Disable_User_feedback"_s, false)) {
+        disabled = true;
+    } else {
+        disabled = a2p && value(u"a2pTypeCd"_s) != u"1";
+    }
+    out[u"inputDisabled"_s] = disabled;
+    return out;
+}
+}
