+        if (info) {
+            m_botNames.insert(botId, RichMessage::botInfo(info->first).value(u"name").toString());
+        }
+    }
+
+    Message message;
+    message.phoneNumberList = phoneNumberList;
+    message.datetime = time.isValid() ? time : QDateTime::currentDateTime();
+    message.deliveryStatus = MessageState::Received;
+    message.sentByMe = false;
+    message.id = Database::generateRandomId();
+    message.read = phoneNumberList == m_disabledNotificationNumber;
+    message.messageId = messageId;
+    message.transport = SL("rcs");
+    message.richContentType = contentType;
+    message.richBody = body;
+    message.suggestions = suggestions;
+    message.botId = botId;
+    // What the conversation list, the notification and anything that cannot
+    // show the card read: header, titles, descriptions, texts, footer.
