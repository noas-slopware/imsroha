From 3950817ece02abd2387712ab263e06741dafa359 Mon Sep 17 00:00:00 2001
From: Noa Himesaka <himesaka@noa.codes>
Date: Wed, 11 Nov 2026 22:45:06 +0900
Subject: [PATCH] daemon: send RCS read reports when the app shows a message

0005 sent MarkDisplayed only from markChatAsRead, which is the chat
list's "mark as read" action. Opening a conversation marks each message
read through markMessageRead instead, so a sender that asked for a
displayed notification never got one. markMessageRead now tells
imsroha-rcs about an unread incoming RCS message before marking it read.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 daemon/channellogger.cpp  |  9 +++++++++
 lib/database/database.cpp | 12 ++++++++++++
 lib/database/database.h   |  2 ++
 3 files changed, 23 insertions(+)

diff --git a/daemon/channellogger.cpp b/daemon/channellogger.cpp
index faf90ca..d4555b3 100644
--- a/daemon/channellogger.cpp
+++ b/daemon/channellogger.cpp
@@ -291,6 +291,15 @@ void ChannelLogger::updateMessageDeliveryState(const QString &id, uint state)
 
 void ChannelLogger::markMessageRead(int id)
 {
+    // The app marks each message read as it shows it; an RCS sender that
+    // asked to know (IMDN "display") is told here, before the row is read.
+    const QStringList rcs = QCoro::waitFor(m_database.unreadRcsMessage(id));
+    if (rcs.size() == 2) {
+        const PhoneNumberList phoneList(rcs.at(0));
+        if (phoneList.size() == 1) {
+            m_rcs.markDisplayed(phoneList.first().toE164(), rcs.at(1));
+        }
+    }
     QCoro::waitFor(m_database.markMessageRead(id));
 }
 
diff --git a/lib/database/database.cpp b/lib/database/database.cpp
index 6e7aa56..c32809e 100644
--- a/lib/database/database.cpp
+++ b/lib/database/database.cpp
@@ -212,6 +212,18 @@ QCoro::Task<std::optional<QString>> Database::idForMessageId(const QString &mess
     });
 }
 
+QCoro::Task<QStringList> Database::unreadRcsMessage(const int id)
+{
+    const auto rows = co_await m_database->getResults<SingleValue<QString>>(
+        SL("SELECT phoneNumber || char(9) || messageId FROM Messages WHERE id == ? AND transport == 'rcs' AND sentByMe == False AND NOT read == True AND messageId != ''"),
+        id);
+    if (rows.empty()) {
+        co_return QStringList();
+    }
+    const QStringList fields = rows.front().value.split(QLatin1Char('\t'));
+    co_return fields.size() == 2 ? fields : QStringList();
+}
+
 QCoro::Task<QStringList> Database::unreadRcsMessageIds(const PhoneNumberList &phoneNumberList)
 {
     const auto rows = co_await m_database->getResults<SingleValue<QString>>(
diff --git a/lib/database/database.h b/lib/database/database.h
index 2f38c03..3c06567 100644
--- a/lib/database/database.h
+++ b/lib/database/database.h
@@ -181,6 +181,8 @@ public:
     // received messages not read yet (for their displayed notifications).
     QCoro::Task<std::optional<QString>> idForMessageId(const QString &messageId);
     QCoro::Task<QStringList> unreadRcsMessageIds(const PhoneNumberList &phoneNumberList);
+    // {phoneNumber, messageId} of an unread incoming RCS message, empty otherwise
+    QCoro::Task<QStringList> unreadRcsMessage(const int id);
     QCoro::Task<> updateMessageTransport(const QString &id, const QString &transport);
 
     // Chats
