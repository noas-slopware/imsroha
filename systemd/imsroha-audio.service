[Unit]
Description=IMSroha call audio (PipeWire bridge for imsroha)
# Part of the graphical session only: every other user manager (root over ssh,
# a second login) must not start a second bridge.
PartOf=graphical-session.target
After=graphical-session.target pipewire.service wireplumber.service
Wants=pipewire.service

[Service]
# Waits on inotify for /run/imsroha/audio.sock and on the socket itself;
# opens playback and capture only while a call has audio.
Type=simple
ExecStart=/usr/bin/imsroha-audio
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
